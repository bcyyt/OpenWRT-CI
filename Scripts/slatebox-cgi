#!/bin/sh
# slatebox 工具箱 CGI — 仪表盘数据 + 实用工具后端
# 鉴权：所有请求校验 LuCI sysauth 会话（ubus session get），未登录 403
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
Q="$QUERY_STRING"

json() { printf 'Content-Type: application/json\r\n\r\n'; }
jerr() { json; printf '{"error":"%s"}' "$1"; exit 0; }

# ── 会话校验（cookie → rpcd session） ──
CK=$(echo "$QUERY_STRING" | sed -n 's/.*sid=\([a-f0-9]\{32\}\).*/\1/p')
[ -n "$CK" ] || CK=$(echo "$HTTP_COOKIE" | sed -n 's/.*sysauth_http=\([a-f0-9]\{32\}\).*/\1/p')
if [ -z "$CK" ] || ! ubus call session get "{\"ubus_rpc_session\":\"$CK\"}" 2>/dev/null | grep -q '"username"'; then
        printf 'Status: 403 Forbidden\r\nContent-Type: application/json\r\n\r\n{"error":"unauthorized"}'
        exit 0
fi

# ── 工具端点 ──
case "$Q" in
ping=*)
        H=${Q#ping=}; H=${H%%&*}
        case "$H" in ''|*[!a-zA-Z0-9.:_-]*) jerr bad-host;; esac
        printf 'Content-Type: text/plain\r\n\r\n'
        ping -c 4 -W 2 "$H" 2>&1
        ;;
speed=1*)
        B1=https://mirrors.tuna.tsinghua.edu.cn/ubuntu/ls-lR.gz
        B2=https://mirrors.aliyun.com/ubuntu/ls-lR.gz
        json
        if command -v curl >/dev/null 2>&1; then
                SP=$(curl -4 -m 12 -r 0-1048575 -o /dev/null -sw '%{speed_download}' "$B1" 2>/dev/null)
                case "$SP" in ''|0|0.000) SP=$(curl -4 -m 12 -r 0-1048575 -o /dev/null -sw '%{speed_download}' "$B2" 2>/dev/null);; esac
                printf '{"speed":%s}' "${SP:-0}"
        else
                T0=$(date +%s%N)
                wget -q -T 10 -O /dev/null "$B1" 2>/dev/null
                T1=$(date +%s%N)
                D=$((T1 - T0)); [ "$D" -lt 1000000 ] && D=1000000
                printf '{"speed":%d}' $((1048576000000 / D))
        fi
        ;;
wol=*)
        M=${Q#wol=}; M=${M%%&*}; M=$(echo "$M" | tr 'A-F' 'a-f')
        case "$M" in ''|*[!0-9a-f:.-]*) jerr bad-mac;; esac
        IF=$(uci -q get network.lan.device); IF=${IF:-br-lan}
        json
        if command -v ether-wake >/dev/null 2>&1; then
                if ether-wake -i "$IF" "$M" 2>/dev/null; then printf '{"ok":1}'; else printf '{"ok":0}'; fi
        elif command -v awake >/dev/null 2>&1; then
                awake -p "$IF" "$M" 2>/dev/null && printf '{"ok":1}' || printf '{"ok":0}'
        else
                printf '{"ok":-1}'
        fi
        ;;
port=*)
        HP=${Q#port=}; HP=${HP%%&*}
        H=${HP%%:*}; P=${HP##*:}
        case "$H$P" in ''|*[!a-zA-Z0-9.:_-]*) jerr bad-target;; esac
        case "$P" in ''|*[!0-9]*) jerr bad-port;; esac
        json
        # busybox micro nc 无 -z、curl 无 telnet/udp —— 统一走 curl HTTP 探测：
        # rc=6 解析失败 / rc=7 拒绝或不可达 / rc=28 连接超时 → 不通；其余=TCP 已连通
        rc=0; curl -s -m 4 --connect-timeout 3 -o /dev/null "http://$H:$P/" || rc=$?
        case "$rc" in
                6) printf '{"state":"dns"}' ;;
                7|28) printf '{"state":"closed"}' ;;
                *) printf '{"state":"open"}' ;;
        esac
        ;;
flush=1*)
        json
        if killall -HUP dnsmasq 2>/dev/null; then printf '{"ok":1}'; else printf '{"ok":0}'; fi
        ;;
renew=1*)
        json; printf '{"ok":1}'
        ( ifup wan2 2>/dev/null; ifup wan 2>/dev/null; ifup wan6 2>/dev/null ) >/dev/null 2>&1 &
        ;;
reboot=1*)
        json; printf '{"ok":1}'
        sleep 1; reboot
        ;;
wifi=1*)
        json; printf '['
        _f=1
        for S in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-iface/\1/p"); do
                [ "$(uci -q get wireless.$S.disabled)" = "1" ] && continue
                SSID=$(uci -q get wireless.$S.ssid); [ -z "$SSID" ] && continue
                ENC=$(uci -q get wireless.$S.encryption); KEY=$(uci -q get wireless.$S.key)
                SSID=$(echo "$SSID" | tr -d '"\\'); KEY=$(echo "$KEY" | tr -d '"\\')
                [ -n "$_f" ] || printf ','
                _f=
                printf '{"ssid":"%s","enc":"%s","key":"%s"}' "$SSID" "${ENC:-none}" "${KEY:-}"
        done
        printf ']'
        ;;
*)
        # ── 仪表盘数据 ──
        json
        CPU=$(awk 'NR==1{print $2","$3","$4","$5","$6","$7","$8","$10}' /proc/stat)
        MEM=$(awk '/^MemTotal:/{t=$2}/^MemAvailable:/{a=$2}END{print t","a}' /proc/meminfo)
        UP=$(cut -d. -f1 /proc/uptime)
        LA=$(cut -d' ' -f1-3 /proc/loadavg | sed 's/ /,/g')
        CTC=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0)
        CTM=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo 65535)
        TMP=$(for Z in /sys/class/thermal/thermal_zone*/temp; do [ -r "$Z" ] && cat "$Z"; done 2>/dev/null | sort -n | tail -1)
        [ -n "$TMP" ] || TMP=0
        TMP=$((TMP / 1000))
        HOSTN=$(cat /proc/sys/kernel/hostname)
        # WAN 逻辑口（默认路由优先）
        WIF=$(ip route show default 2>/dev/null | awk 'NR==1{for(i=1;i<=NF;i++)if($i=="dev")print $(i+1)}')
        [ -n "$WIF" ] || WIF=$(uci -q get network.wan.device)
        # 逻辑名→物理口映射
        MAP=$(ubus call network.interface dump 2>/dev/null | awk 'BEGIN{ORS=""}/"interface": "/{gsub(/[",]/,"",$2); i=$2}/"l3_device": "/{gsub(/[",]/,"",$2); d=$2; if(d!=""&&d!="lo"&&i!=""&&i!=d){printf "%s%s=%s",(_m?",":""),i,d; _m=1}; i=""}')
        # 接口字节
        NET=$(awk 'NR>2{iface=$1;sub(/:$/,"",iface);gsub(/[ \t]/,"",iface);if(iface!=""&&iface!="lo"&&$2~/^[0-9]+$/&&$10~/^[0-9]+$/){printf "%s\"%s\":{\"rx\":%s,\"tx\":%s}",(_n?",":""),iface,$2,$10;_n=1}}' /proc/net/dev 2>/dev/null)
        # DHCP 客户端
        CLS=""
        _n=1
        if [ -s /tmp/dhcp.leases ]; then
                while read _exp _mac _ip _name _cid; do
                        _name=$(echo "$_name" | tr -d '"\\')
                        [ "$_name" = "*" ] && _name="${_ip}"
                        [ -n "$_n" ] || CLS="$CLS,"
                        _n=
                        CLS="$CLS[\"$_name\",\"$_ip\",\"$_mac\"]"
                done </tmp/dhcp.leases
        fi
        printf '{"ts":%s,"host":"%s","up":%s,"la":[%s],"cpu":[%s],"mem":[%s],"temp":%s,"ct":[%s,%s],"wanif":"%s","map":"%s","clients":[%s],"net":{%s}}' \
                "$(date +%s)" "$HOSTN" "$UP" "$LA" "$CPU" "$MEM" "$TMP" "$CTC" "$CTM" "$WIF" "$MAP" "$CLS" "$NET"
        ;;
esac
