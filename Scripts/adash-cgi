_sm_sets_harvest() {
    [ -f /proc/net/nf_conntrack ] || return 0
    awk '
      BEGIN{
        skip["223.5.5.5"]=1; skip["223.6.6.6"]=1; skip["8.8.8.8"]=1; skip["8.8.4.4"]=1
        skip["1.1.1.1"]=1; skip["1.0.0.1"]=1; skip["114.114.114.114"]=1
        skip["119.29.29.29"]=1; skip["180.76.76.76"]=1; skip["9.9.9.9"]=1
      }
      {
        p=$3; d1=""; dport=""; b1=0; b2=0; pk=0
        for(i=1;i<=NF;i++){
          if($i~/^dst=/&&d1=="") d1=substr($i,5)
          if($i~/^dport=/&&dport=="") dport=substr($i,7)
          if($i~/^bytes=/){ if(!b1) b1=substr($i,7)+0; else b2=substr($i,7)+0 }
          if($i~/^packets=/) pk+=substr($i,9)+0
        }
        if(d1==""||dport!="443") next
        if(skip[d1]) next
        if(d1 ~ /^10\./ || d1 ~ /^192\.168\./ || d1 ~ /^127\./ || d1 ~ /^169\.254\./) next
        if(d1 ~ /^172\.(1[6-9]|2[0-9]|3[01])\./) next
        if(d1 ~ /^100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\./) next
        if(d1 ~ /^[fF][eE]80:/ || d1 ~ /^[fF][cCdD]/ || d1=="::1") next
        bytes=b1+b2
        if(p=="udp") print d1
        else if(p=="tcp" && (bytes>=262144 || pk>=200)) print d1
      }
    ' /proc/net/nf_conntrack | _sm_sets_add_ips vidips
}

_sm_sets_seed() {
    local stamp=/tmp/adash-seed.ts last=0
    last=$(cat "$stamp" 2>/dev/null || echo 0)
    _sm_nftset_conf
    _sm_sets_harvest
    [ $((NOW - last)) -lt 300 ] && { _sm_sets_save; return 0; }
    echo "$NOW" > "$stamp"
    local VID_HOSTS="www.bilibili.com api.bilibili.com live.bilibili.com upos-sz-mirrorcos.bilivideo.com upos-sz-mirrorhw.bilivideo.com upos-sz-estghw.bilivideo.com upos-sz-mirrorali.bilivideo.com i0.hdslb.com i1.hdslb.com i2.hdslb.com www.douyin.com v3-web.douyinvod.com lf3-cdn-tos.douyinstatic.com www.iqiyi.com cache.video.iqiyi.com v.youku.com video.qq.com www.mgtv.com www.huya.com www.douyu.com live.kuaishou.com www.youtube.com googlevideo.com"
    local DL_HOSTS="pan.baidu.com d.pcs.baidu.com www.aliyundrive.com www.alipan.com pan.quark.cn cloud.189.cn www.123pan.com 115.com drive.uc.cn"
    _sm_sets_restore
    _sm_resolve_hosts "$VID_HOSTS" | _sm_sets_add_ips vidips
    _sm_resolve_hosts "$DL_HOSTS" | _sm_sets_add_ips dlips
    _sm_sets_save
}

_sm_cron_ensure() {
    grep -q 'adash-acct-accumulate' /etc/crontabs/root 2>/dev/null && return 0
    mkdir -p /etc/crontabs 2>/dev/null
    touch /etc/crontabs/root 2>/dev/null
    echo '* * * * * QUERY_STRING=accumulate=1 /www/cgi-bin/adash >/dev/null 2>&1 # adash-acct-accumulate' >> /etc/crontabs/root
    /etc/init.d/cron reload >/dev/null 2>&1
}

# v4.16：CPU/内存/温度 24h 滚动采样（cron 每分钟，独立 CPU 窗口）
_sm_sys_hist_cpu() {
    local tot idl pt pi pu dt di usage=0
    read -r _ u n s i w q sq st _ _ < /proc/stat 2>/dev/null
    [ -z "$i" ] && { echo 0; return; }
    tot=$((u + n + s + i + w + q + sq + st))
    idl=$((i + w))
    pt=0; pi=0; pu=0
    [ -f "$SYS_HIST_CPU" ] && read -r pt pi pu < "$SYS_HIST_CPU" 2>/dev/null
    case "$pt" in ''|*[!0-9]*) pt=0 ;; esac
    case "$pi" in ''|*[!0-9]*) pi=0 ;; esac
    case "$pu" in ''|*[!0-9]*) pu=0 ;; esac
    dt=$((tot - pt))
    di=$((idl - pi))
    if [ "$pt" -eq 0 ] || [ "$dt" -le 0 ]; then
        usage=$pu
    else
        usage=$(( (dt - di) * 100 / dt ))
        [ "$usage" -lt 0 ] && usage=0
        [ "$usage" -gt 100 ] && usage=100
    fi
    printf '%s %s %s\n' "$tot" "$idl" "$usage" > "$SYS_HIST_CPU.$$" 2>/dev/null && mv -f "$SYS_HIST_CPU.$$" "$SYS_HIST_CPU" 2>/dev/null
    echo "$usage"
}

_sm_sys_hist_temp() {
    local t z h
    for z in /sys/class/thermal/thermal_zone*; do
        [ -f "$z/type" ] && [ "$(cat "$z/type" 2>/dev/null)" = "x86_pkg_temp" -o "$(cat "$z/type" 2>/dev/null)" = "cpu-thermal" -o "$(cat "$z/type" 2>/dev/null)" = "cpu_thermal" ] && [ -f "$z/temp" ] && {
            t=$(cat "$z/temp" 2>/dev/null)
            [ -n "$t" ] && { awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'; return; }
        }
    done
    for h in /sys/class/hwmon/hwmon*; do
        [ -f "$h/name" ] && [ "$(cat "$h/name" 2>/dev/null)" = "coretemp" -o "$(cat "$h/name" 2>/dev/null)" = "cpu_thermal" ] && [ -f "$h/temp1_input" ] && {
            t=$(cat "$h/temp1_input" 2>/dev/null)
            [ -n "$t" ] && { awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'; return; }
        }
    done
    # ARM/SoC：热区或 hwmon 名称含 cpu/soc（如 MT7986 的 cpu-thermal / cpu_thermal）
    for z in /sys/class/thermal/thermal_zone*; do
        [ -f "$z/type" ] && [ -f "$z/temp" ] || continue
        case "$(cat "$z/type" 2>/dev/null)" in
            *cpu*|*CPU*|*soc*|*SoC*)
                t=$(cat "$z/temp" 2>/dev/null)
                case "$t" in ''|*[!0-9]*) ;; *) awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'; return ;; esac
                ;;
        esac
    done
    for h in /sys/class/hwmon/hwmon*; do
        [ -f "$h/name" ] && [ -f "$h/temp1_input" ] || continue
        case "$(cat "$h/name" 2>/dev/null)" in
            *cpu*|*CPU*|*soc*|*SoC*)
                t=$(cat "$h/temp1_input" 2>/dev/null)
                case "$t" in ''|*[!0-9]*) ;; *) awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'; return ;; esac
                ;;
        esac
    done
    echo "0"
}

_sm_sys_hist_disk() {
    local h t
    for h in /sys/class/hwmon/hwmon*; do
        [ -f "$h/name" ] || continue
        case "$(cat "$h/name" 2>/dev/null)" in
            nvme|drivetemp)
                [ -f "$h/temp1_input" ] || continue
                t=$(cat "$h/temp1_input" 2>/dev/null)
                [ -n "$t" ] && { awk -v v="$t" 'BEGIN{printf "%.1f", v/1000}'; return; }
                ;;
        esac
    done
    echo "0"
}

_sm_sys_hist_mem() {
    awk '
      /^MemTotal:/{t=$2}
      /^MemFree:/{f=$2}
      /^Cached:/{c=$2}
      /^Buffers:/{b=$2}
      END{if(t>0){u=t-f-c-b;if(u<0)u=0;printf "%d", int(u*100/t+0.5)} else print 0}
    ' /proc/meminfo 2>/dev/null
}

sys_hist_sample() {
    local cpu mem temp cut lastf first=0
    mkdir -p "$PROTO_DIR" 2>/dev/null
    [ -s "$SYS_HIST_TMP" ] || { [ -s "$SYS_HIST_FILE" ] && cp -f "$SYS_HIST_FILE" "$SYS_HIST_TMP" 2>/dev/null; }
    [ -f "$SYS_HIST_CPU" ] || first=1
    cpu=$(_sm_sys_hist_cpu)
    # adash：无 worker，直接用 _sm_sys_hist_cpu 的 1 分钟差分（成本≈0）
    mem=$(_sm_sys_hist_mem)
    temp=${_sm_cpu_temp_now:-$(_sm_sys_hist_temp)}
    disk=${_sm_disk_temp_now:-$(_sm_sys_hist_disk)}
    cpu=${cpu:-0}; mem=${mem:-0}; temp=${temp:-0}; disk=${disk:-0}
    [ "$first" = 1 ] && return 0
    cut=$((NOW - SYS_HIST_WIN))
    {
        [ -s "$SYS_HIST_TMP" ] && awk -v cut="$cut" '$1+0>=cut{print}' "$SYS_HIST_TMP"
        printf '%s %s %s %s %s\n' "$NOW" "$cpu" "$mem" "$temp" "$disk"
    } > "$SYS_HIST_TMP.new" 2>/dev/null
    mv -f "$SYS_HIST_TMP.new" "$SYS_HIST_TMP" 2>/dev/null
    lastf=$(cat "$SYS_HIST_FLUSH" 2>/dev/null || echo 0)
    case "$lastf" in ''|*[!0-9]*) lastf=0 ;; esac
    if [ $((NOW - lastf)) -ge 300 ]; then
        cp -f "$SYS_HIST_TMP" "$SYS_HIST_FILE" 2>/dev/null
        echo "$NOW" > "$SYS_HIST_FLUSH"
    fi
}

sys_hist_json() {
    local f="$SYS_HIST_TMP"
    [ -s "$f" ] || f="$SYS_HIST_FILE"
    [ -s "$f" ] || { echo '{"points":[]}'; return; }
    awk -v cut="$((NOW - SYS_HIST_WIN))" '
      BEGIN{print "{\"points\":["}
      $1+0>=cut{
        if(n++) printf ","
        printf "{\"t\":%d,\"c\":%d,\"m\":%d,\"p\":%s,\"d\":%s}", $1+0, $2+0, $3+0, ($4==""?"0":$4), ($5==""?"0":$5)
      }
      END{print "]}"}
    ' "$f"
}

# $1 = force（1 = 强制刷写今日归档，供 ?proto_day 弹窗打开时用）


# ===== PPPoE 接口字节跨重拨累计（v4.26）=====
# 内核计数随 pppoe-wan 重建归零；LAST 为上次内核值，OFF 为已结束会话的累计。
# 当前内核值小于 LAST，或 ifindex 变了，把 LAST 加进 OFF。展示值 = 当前 + OFF。
PPPOE_ACCT=/tmp/adash-pppoe-acct.txt
PPPACC_NAMES=""

_sm_pppoe_acct_load() {
    PPPACC_NAMES=""
    [ -s "$PPPOE_ACCT" ] || return 0
    while read _n _lr _lt _or _ot _ifi _; do
        case "$_n" in pppoe-*|ppp-*) ;; *) continue ;; esac
        _m=${_n//-/_}; _m=${_m//./_}
        eval "PPPACC_${_m}='${_lr:-0} ${_lt:-0} ${_or:-0} ${_ot:-0} ${_ifi:-0}'"
        PPPACC_NAMES="$PPPACC_NAMES $_n"
    done < "$PPPOE_ACCT"
}

_sm_pppoe_fold() {
    _m=${iface//-/_}; _m=${_m//./_}
    _rx=$rx_bytes; _tx=$tx_bytes
    eval "_v=\${PPPACC_${_m}:-0 0 0 0 0}"
    _lr=${_v%% *}; _v=${_v#* }
    _lt=${_v%% *}; _v=${_v#* }
    _or=${_v%% *}; _v=${_v#* }
    _ot=${_v%% *}; _oldif=${_v#* }
    _oldif=${_oldif%% *}
    _lr=${_lr:-0}; _lt=${_lt:-0}; _or=${_or:-0}; _ot=${_ot:-0}; _oldif=${_oldif:-0}
    _ifi=$(cat "/sys/class/net/$iface/ifindex" 2>/dev/null)
    _ifi=${_ifi:-0}
    if [ "$_oldif" != "0" ] && [ "$_ifi" != "0" ] && [ "$_ifi" != "$_oldif" ]; then
        _or=$((_or + _lr))
        _ot=$((_ot + _lt))
    else
        if [ "$_rx" -lt "$_lr" ] 2>/dev/null; then
            _or=$((_or + _lr))
        fi
        if [ "$_tx" -lt "$_lt" ] 2>/dev/null; then
            _ot=$((_ot + _lt))
        fi
    fi
    rx_bytes=$((_rx + _or))
    tx_bytes=$((_tx + _ot))
    eval "PPPACC_${_m}='$_rx $_tx $_or $_ot $_ifi'"
    case " $PPPACC_NAMES " in
        *" $iface "*) ;;
        *) PPPACC_NAMES="$PPPACC_NAMES $iface" ;;
    esac
}

_sm_pppoe_acct_tick() {
    _sm_pppoe_acct_load
    for iface in /sys/class/net/pppoe-* /sys/class/net/ppp-*; do
        [ -e "$iface" ] || continue
        iface=$(basename "$iface")
        case "$iface" in pppoe-*|ppp-*) ;; *) continue ;; esac
        _cnt=$(awk -v n="$iface:" '$1==n{print $2" "$10; exit}' /proc/net/dev 2>/dev/null)
        rx_bytes=${_cnt%% *}; tx_bytes=${_cnt#* }
        rx_bytes=${rx_bytes:-0}; tx_bytes=${tx_bytes:-0}
        _sm_pppoe_fold
    done
    [ -n "$PPPACC_NAMES" ] && _sm_pppoe_acct_save
}

_sm_pppoe_acct_save() {
    : > "$PPPOE_ACCT.new"
    for _n in $PPPACC_NAMES; do
        _m=${_n//-/_}; _m=${_m//./_}
        eval "_v=\${PPPACC_${_m}:-}"
        [ -n "$_v" ] && echo "$_n $_v" >> "$PPPOE_ACCT.new"
    done
    [ -s "$PPPOE_ACCT.new" ] && mv -f "$PPPOE_ACCT.new" "$PPPOE_ACCT"
}

# ===== 客户端流量持久累计引擎（v4.42，上传 nft ingress + 下载 tc egress）=====
# 上传：netdev/adash_acct 的 cliul4/cliul6 动态 set。br-lan ingress(-100)
#       先于 flowtable(offload, prio 0) 执行，offload 下仍完整计数。
# 下载：br-lan 物理端口 egress clsact 的 u32 过滤器按目的 IP 计数。WAN ingress
#       是 DNAT 前地址（目的还是公网 IP），拿不到客户端；网桥主设备 egress 分类器
#       看不到转发帧，必须挂到物理端口；端口 egress 已是 DNAT 后地址，且 flow
#       offload 下仍走 dev_queue_xmit，因此可计数（依赖 tc-tiny）。
#       pref 1/2 用 LAN 源地址提前放行，排除路由器本机产生/内网互访流量。
# 每次采样与快照做差，增量按 MAC 归属累加到当日文件；计数器重建时按重置处理。
# 从旧口径切换过来时 src!=tcegress，首采只建基准不累加。
CLIENT_STATE=/tmp/adash-client-state.txt
CLIENT_RATEF=/tmp/adash-client-rate.txt
TC_BRIDGE=br-lan
TC_MAP=/tmp/adash-tc-map.txt
TC_DESIRED=/tmp/adash-tc-desired.txt
TC_SRC_MARK=/tmp/adash-tc-src.txt
TC_PORTS=""

# 网桥主设备的 egress 分类器看不到转发帧，必须挂到 br-lan 的物理端口上
_sm_tc_ports() {
    local p
    for p in /sys/class/net/"$TC_BRIDGE"/brif/*; do
        [ -e "$p" ] || continue
        p=${p##*/}
        [ "$(cat /sys/class/net/"$p"/operstate 2>/dev/null)" = "up" ] || continue
        echo "$p"
    done
}

_sm_tc_ready() {
    command -v tc >/dev/null 2>&1 || return 1
    TC_PORTS=""
    local p
    for p in $(_sm_tc_ports); do
        if ! tc qdisc show dev "$p" 2>/dev/null | grep -q clsact; then
            tc qdisc add dev "$p" clsact >/dev/null 2>&1 || continue
            : > "$TC_MAP"
            : > "$TC_SRC_MARK"
        fi
        TC_PORTS="$TC_PORTS $p"
    done
    [ -n "$TC_PORTS" ]
}

_sm_tc_src_ensure() {
    local lan4 v6el sig p cur
    lan4=$(ip -4 route show dev "$SM_LAN_DEV" 2>/dev/null | awk '/proto kernel/{printf "%s ",$1}')
    [ -n "$lan4" ] || lan4=192.168.10.0/24
    v6el=$(_sm_lan6_elems)
    sig="4:$lan4 6:$v6el"
    : > "$TC_SRC_MARK.new"
    for p in $TC_PORTS; do
        echo "$p|$sig" >> "$TC_SRC_MARK.new"
        cur=$(awk -F'|' -v d="$p" '$1==d{print $2;exit}' "$TC_SRC_MARK" 2>/dev/null)
        [ "$cur" = "$sig" ] && continue
        tc filter del dev "$p" egress protocol ip pref 1 >/dev/null 2>&1
        tc filter del dev "$p" egress protocol ipv6 pref 2 >/dev/null 2>&1
        for cur in $lan4 127.0.0.0/8 169.254.0.0/16; do
            tc filter add dev "$p" egress protocol ip pref 1 u32 match ip src "$cur" action ok >/dev/null 2>&1
        done
        for cur in $(echo "$v6el" | tr ',' ' '); do
            [ -n "$cur" ] && tc filter add dev "$p" egress protocol ipv6 pref 2 u32 match ip6 src "$cur" action ok >/dev/null 2>&1
        done
    done
    mv -f "$TC_SRC_MARK.new" "$TC_SRC_MARK"
}

_sm_tc_desired_build() {
    local out="$1" clients="$1.clients" p fam ip
    : > "$clients"
    [ "$LSE" != /dev/null ] && awk '$3 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $3!="0.0.0.0"{print "4|"$3}' "$LSE" >> "$clients"
    ip -4 neigh show dev "$SM_LAN_DEV" 2>/dev/null | awk '
      {ip=$1;mac="";for(i=2;i<NF;i++)if($i=="lladdr")mac=$(i+1)
       if(ip==""||mac==""||mac=="00:00:00:00:00:00")next
       if($NF!="REACHABLE"&&$NF!="DELAY"&&$NF!="PROBE"&&$NF!="STALE")next
       print "4|"ip}' >> "$clients"
    ip -6 neigh show dev "$SM_LAN_DEV" 2>/dev/null | awk '
      {ip=$1;mac="";for(i=2;i<NF;i++)if($i=="lladdr")mac=$(i+1)
       if(ip==""||mac==""||mac=="00:00:00:00:00:00")next
       if($NF!="REACHABLE"&&$NF!="DELAY"&&$NF!="PROBE"&&$NF!="STALE")next
       if(index(ip,":")==0||substr(ip,1,5)=="fe80:")next
       print "6|"ip}' >> "$clients"
    sort -u "$clients" > "$clients.new" && mv -f "$clients.new" "$clients"
    : > "$out"
    for p in $TC_PORTS; do
        while IFS='|' read -r fam ip; do
            [ -n "$fam" ] && [ -n "$ip" ] && echo "$p|$fam|$ip" >> "$out"
        done < "$clients"
    done
    sort -u "$out" > "$out.new" && mv -f "$out.new" "$out"
}

_sm_tc_rebuild() {
    local p dev fam ip major minor
    [ -n "$TC_PORTS" ] || return 1
    : > "$TC_MAP.new"
    for p in $TC_PORTS; do
        tc filter del dev "$p" egress protocol ip pref 100 >/dev/null 2>&1
        tc filter del dev "$p" egress protocol ipv6 pref 200 >/dev/null 2>&1
        if grep -q "^$p|4|" "$TC_DESIRED" 2>/dev/null; then
            tc filter add dev "$p" egress protocol ip pref 100 u32 match ip dst 0.0.0.0/32 action pass >/dev/null 2>&1
            major=$(tc filter show dev "$p" egress pref 100 2>/dev/null | awk '/fh [0-9a-f]+: ht/{for(i=1;i<=NF;i++)if($i=="fh"){h=$(i+1);sub(/:.*/,"",h);print h;exit}}')
            minor=100
            while IFS='|' read -r dev fam ip; do
                [ "$dev" = "$p" ] && [ "$fam" = 4 ] || continue
                [ -n "$major" ] || break
                tc filter add dev "$p" egress protocol ip pref 100 handle "${major}::${minor}" u32 match ip dst "$ip"/32 action pass >/dev/null 2>&1 && \
                    echo "$p|4|$major|$minor|$ip" >> "$TC_MAP.new"
                minor=$((minor + 1))
            done < "$TC_DESIRED"
        fi
        if grep -q "^$p|6|" "$TC_DESIRED" 2>/dev/null; then
            tc filter add dev "$p" egress protocol ipv6 pref 200 u32 match ip6 dst ::/128 action pass >/dev/null 2>&1
            major=$(tc filter show dev "$p" egress pref 200 2>/dev/null | awk '/fh [0-9a-f]+: ht/{for(i=1;i<=NF;i++)if($i=="fh"){h=$(i+1);sub(/:.*/,"",h);print h;exit}}')
            minor=100
            while IFS='|' read -r dev fam ip; do
                [ "$dev" = "$p" ] && [ "$fam" = 6 ] || continue
                [ -n "$major" ] || break
                tc filter add dev "$p" egress protocol ipv6 pref 200 handle "${major}::${minor}" u32 match ip6 dst "$ip"/128 action pass >/dev/null 2>&1 && \
                    echo "$p|6|$major|$minor|$ip" >> "$TC_MAP.new"
                minor=$((minor + 1))
            done < "$TC_DESIRED"
        fi
    done
    mv -f "$TC_MAP.new" "$TC_MAP"
}

client_accumulate() {
    if command -v flock >/dev/null 2>&1; then
        exec 8>/tmp/adash-client.lock
        flock -n -x 8 2>/dev/null || return 1
    fi
    nft list chain netdev $SM_TABLE dl >/dev/null 2>&1 || _sm_nft_ensure
    _sm_nft_cli_sets_ensure
    _sm_nft_cli_rules_ensure
    TODAY=$(date +%F)
    TOTALF="$PROTO_DIR/client-total-$TODAY.txt"
    [ -d "$PROTO_DIR" ] || mkdir -p "$PROTO_DIR" 2>/dev/null
    LSE=/tmp/dhcp.leases
    [ -f "$LSE" ] || LSE=/dev/null
    CSIN="$CLIENT_STATE"; [ -s "$CSIN" ] || CSIN=/dev/null
    TOTIN="$TOTALF";     [ -s "$TOTIN" ] || TOTIN=/dev/null
    RIN="$CLIENT_RATEF"; [ -s "$RIN" ] || RIN=/dev/null
    N4F=/tmp/.sm_can4.$$
    N6F=/tmp/.sm_can6.$$
    NFTF=/tmp/.sm_nftcli.$$
    TCF=/tmp/.sm_tc.$$
    MAPL=/tmp/.sm_tcmapl.$$
    ip -4 neigh show 2>/dev/null > "$N4F"
    ip -6 neigh show 2>/dev/null > "$N6F"
    {
        echo "===ul4==="
        nft list set netdev $SM_TABLE cliul4 2>/dev/null
        echo "===ul6==="
        nft list set netdev $SM_TABLE cliul6 2>/dev/null
    } > "$NFTF"
    : > "$TCF"
    TC_REBUILT=0
    if _sm_tc_ready; then
        _sm_tc_src_ensure
        _sm_tc_desired_build "$TC_DESIRED"
        awk -F'|' 'NF>=5{print $1"|"$2"|"$5}' "$TC_MAP" 2>/dev/null | sort -u > "$MAPL"
        cmp -s "$MAPL" "$TC_DESIRED" || TC_REBUILT=1
        for p in $TC_PORTS; do
            echo "===dev $p" >> "$TCF"
            tc -s filter show dev "$p" egress >> "$TCF" 2>/dev/null
        done
    fi
    MAPIN="$TC_MAP"; [ -s "$MAPIN" ] || MAPIN=/dev/null
    rm -f "$TOTALF.new" "$CLIENT_STATE.new" "$CLIENT_RATEF.new"
    awk -v LSE="$LSE" -v N4F="$N4F" -v N6F="$N6F" -v NFTF="$NFTF" -v TCF="$TCF" -v MAPIN="$MAPIN" \
      -v STATEIN="$CSIN" -v TOTALIN="$TOTIN" -v RATEIN="$RIN" \
      -v STATEF="$CLIENT_STATE" -v TOTALF="$TOTALF" -v RATEF="$CLIENT_RATEF" -v NOWS="$NOW" '
      function stripz(g){while(length(g)>1&&substr(g,1,1)=="0")g=substr(g,2);return g}
      function canon(v,  p,h,t,hn,tn,i,g,out){
        v=tolower(v)
        if(v~/::/){split(v,p,"::");hn=0;tn=0
          if(p[1]!="")hn=split(p[1],h,":")
          if(p[2]!="")tn=split(p[2],t,":")
          for(i=1;i<=hn;i++)g[i]=h[i]
          for(i=1;i<=8-hn-tn;i++)g[hn+i]="0"
          for(i=1;i<=tn;i++)g[8-tn+i]=t[i]
        } else split(v,g,":")
        out="";for(i=1;i<=8;i++){if(i>1)out=out":";out=out stripz(g[i])}
        return out
      }
      FILENAME==LSE && LSE!="/dev/null"{
        if($3!="" && index($2,":")>0 && !($3 in macof))macof[$3]=$2
        next
      }
      (FILENAME==N4F||FILENAME==N6F) && FILENAME!="/dev/null"{
        ip=$1;mac=""
        for(i=2;i<NF;i++){if($i=="lladdr"&&mac=="")mac=$(i+1)}
        if(ip==""||mac==""||mac=="00:00:00:00:00:00")next
        if($NF!="REACHABLE"&&$NF!="DELAY"&&$NF!="PROBE"&&$NF!="STALE")next
        if(index(ip,":")){if(substr(ip,1,5)=="fe80:")next;ip=canon(ip)}
        if(!(ip in macof))macof[ip]=mac
        next
      }
      FILENAME==STATEIN && STATEIN!="/dev/null"{
        if($1~/^ts=/){lastts=substr($1,4)+0;next}
        if($1~/^src=/){lastsrc=substr($1,5);next}
        split($0,a,"|");if(a[1]!=""){lup[a[1]]=a[2]+0;ldn[a[1]]=a[3]+0}
        next
      }
      FILENAME==TOTALIN && TOTALIN!="/dev/null"{
        split($0,a,"|");if(a[1]!=""){crx[a[1]]=a[2]+0;ctx[a[1]]=a[3]+0}
        next
      }
      FILENAME==RATEIN && RATEIN!="/dev/null"{
        split($0,a,"|")
        if(a[1]!=""){
          wrts[a[1]]=a[2]+0;wrx[a[1]]=a[3]+0;wtx[a[1]]=a[4]+0
          wrr[a[1]]=a[5]+0;wrt[a[1]]=a[6]+0
        }
        next
      }
      FILENAME==NFTF && NFTF!="/dev/null"{
        if($0~/^===ul/){sec="ul";next}
        for(i=1;i<=NF;i++){
          if($i=="counter" && i>1){
            ip=$(i-1); gsub(/[{},]/,"",ip)
            if(ip==""||ip=="elements"||ip=="="||ip=="{")continue
            b=0
            for(j=i;j<NF;j++) if($(j)=="bytes"){b=$(j+1)+0;break}
            if(index(ip,":"))ip=canon(ip)
            up[ip]+=b
            seenip[ip]=1
          }
        }
        next
      }
      FILENAME==MAPIN && MAPIN!="/dev/null"{
        split($0,a,"|")
        if(a[1]!=""&&a[2]!=""&&a[3]!=""&&a[4]!=""&&a[5]!="")tcip[a[1]"|"a[2]"|"a[3]"::"a[4]]=a[5]
        next
      }
      FILENAME==TCF && TCF!="/dev/null"{
        if($1=="===dev"){tcdev=$2;fam="";cur="";next}
        if($1=="filter"&&$2=="protocol"){fam=($3=="ipv6")?"6":"4";cur=""}
        for(i=1;i<NF;i++)if($i=="fh")cur=tcdev"|"fam"|"$(i+1)
        if($1=="Sent"&&cur!=""){b=$2+0;if(b>tc[cur])tc[cur]=b}
        next
      }
      END{
        have_state=(lastts+0)>0 && lastsrc=="tcegress"
        for(k in tc)if(k in tcip){ip=tcip[k];if(tc[k]>dn[ip])dn[ip]=tc[k];seenip[ip]=1}
        if(have_state){
          for(ip in seenip){
            m=macof[ip]; if(m=="")continue
            du=up[ip]-(lup[ip]+0); if(du<0)du=up[ip]+0
            dd=dn[ip]-(ldn[ip]+0); if(dd<0)dd=dn[ip]+0
            crx[m]+=dd;ctx[m]+=du
          }
        }
        for(m in crx)print m "|" crx[m]+0 "|" ctx[m]+0 > TOTALF ".new"
        close(TOTALF ".new")
        print "ts=" NOWS > STATEF ".new"
        print "src=tcegress" > STATEF ".new"
        for(ip in seenip)print ip "|" up[ip]+0 "|" dn[ip]+0 > STATEF ".new"
        close(STATEF ".new")
        for(m in crx){
          if(!(m in wrts)){
            print m "|" NOWS "|" crx[m]+0 "|" ctx[m]+0 "|0|0" > RATEF ".new"
          } else {
            wdtd=NOWS-(wrts[m]+0)
            if(wdtd>=6){
              wdrx=crx[m]-(wrx[m]+0);if(wdrx<0)wdrx=0
              wdtx=ctx[m]-(wtx[m]+0);if(wdtx<0)wdtx=0
              wrrate=0;wtrate=0
              if(wdtd>0){wrrate=int(wdrx/wdtd);wtrate=int(wdtx/wdtd)}
              print m "|" NOWS "|" crx[m]+0 "|" ctx[m]+0 "|" wrrate "|" wtrate > RATEF ".new"
            } else {
              print m "|" wrts[m]+0 "|" wrx[m]+0 "|" wtx[m]+0 "|" wrr[m]+0 "|" wrt[m]+0 > RATEF ".new"
            }
          }
        }
        close(RATEF ".new")
      }
      ' "$LSE" "$N4F" "$N6F" "$NFTF" "$TCF" "$MAPIN" "$CSIN" "$TOTIN" "$RIN" 2>/dev/null
    [ -s "$TOTALF.new" ] && mv -f "$TOTALF.new" "$TOTALF" 2>/dev/null
    [ -s "$CLIENT_STATE.new" ] && mv -f "$CLIENT_STATE.new" "$CLIENT_STATE" 2>/dev/null
    [ -s "$CLIENT_RATEF.new" ] && mv -f "$CLIENT_RATEF.new" "$CLIENT_RATEF" 2>/dev/null
    if [ "$TC_REBUILT" = 1 ]; then
        if _sm_tc_rebuild; then
            awk -F'|' 'BEGIN{OFS="|"} /^ts=/{print;next} /^src=/{print "src=tcegress";next} NF>=3{print $1,$2,0}' "$CLIENT_STATE" > "$CLIENT_STATE.new"
            [ -s "$CLIENT_STATE.new" ] && mv -f "$CLIENT_STATE.new" "$CLIENT_STATE"
        fi
    fi
    rm -f "$N4F" "$N6F" "$NFTF" "$TCF" "$MAPL" "$TC_DESIRED.new" "$TC_DESIRED.clients" "$TC_DESIRED.clients.new" \
        "$TC_SRC_MARK.new" "$TOTALF.new" "$CLIENT_STATE.new" "$CLIENT_RATEF.new" "$TC_MAP.new"
    return 0
}

# ===== live 实时端点（v4.50）=====
# 仅零 spawn 读 /proc，绕过 25s 整包缓存——2s 轮询接口字节永远新鲜，速率差分不失真。
# 整包缓存只保护重活(nft×13/conntrack)；本端点 <10ms，专修"流量不准/不及时"。
# map：逻辑接口名=物理口（如 wan2=lan3），前端用它把物理口字节归到逻辑名。
_qs_live=$(echo "$QUERY_STRING" | sed -n 's/^live=\([^&]*\).*/\1/p')
if [ -n "$_qs_live" ]; then
    exec 2>/dev/null
    _la=$(cut -d' ' -f1-3 /proc/loadavg | sed 's/ /,/g')
    _cpu=$(awk 'NR==1{print $2","$3","$4","$5","$6","$7","$8","$10}' /proc/stat)
    printf '{"ts":%s,"up":%s,"la":[%s],"cpu":[%s],"map":"' "$(date +%s)" "$(cut -d. -f1 /proc/uptime)" "$_la" "$_cpu"
    ubus call network.interface dump 2>/dev/null | awk 'BEGIN{ORS=""}/"interface": "/{gsub(/[",]/,"",$2); i=$2}/"l3_device": "/{gsub(/[",]/,"",$2); d=$2;printf "%s%s=%s",(_m?",":""),i,d; _m=1; i=""}'
    printf '","net":{'
    awk 'NR>2 {iface=$1; sub(/:$/,"",iface); gsub(/[    ]/,"",iface); if(iface!="" && iface!="lo" && $2 ~ /^[0-9]+$/ && $10 ~ /^[0-9]+$/) {printf "%s\"%s\":{\"rx\":%s,\"tx\":%s}", (_f?",":""), iface, $2, $10; _f=1}}' /proc/net/dev 2>/dev/null
    printf '}}
'
    exit 0
fi

# ===== adash 低 CPU 支撑函数 =====
# CPU：视图请求间差分（/proc/stat；两次请求间隔即窗口，无人查看零成本）
_ad_cpu_view() {
    local u s t now pt pu ps pv dt v
    set -- $(awk '/^cpu /{print $2+$3, $4+$7+$8, $2+$3+$4+$5+$6+$7+$8}' /proc/stat 2>/dev/null)
    u=${1:-0}; s=${2:-0}; t=${3:-1}; now=$(date +%s)
    v=-1
    if [ -s /tmp/adash-cpu-view.state ]; then
        read pt pu ps pv < /tmp/adash-cpu-view.state 2>/dev/null
        dt=$((t - pt))
        if [ "$dt" -gt 200 ] 2>/dev/null; then
            v=$(( ((u - pu) + (s - ps)) * 100 / dt ))
            [ "$v" -gt 100 ] && v=100
        elif [ "$dt" -le 0 ] 2>/dev/null; then
            v=${pv:--1}
        fi
    fi
    printf '%d %d %d %d\n' "$t" "$u" "$s" "$v" > /tmp/adash-cpu-view.state.tmp.$$ 2>/dev/null \
        && mv -f /tmp/adash-cpu-view.state.tmp.$$ /tmp/adash-cpu-view.state 2>/dev/null
    echo "$v"
}

# PPE 表项占用：60s 视图驱动缓存（原 statusppe worker 每 5s 常驻采样，已移除）
# 三布局适配（对齐原 worker v5 全量逻辑）：
#   A. 6.18 双引擎：/sys/kernel/debug/ppe{0,1}/entries + bind（t=行数 v4/v6=协议计数 b*=绑定计数）
#   B. MTK 6.12：/sys/kernel/debug/mtk_ppe/entries 单文件（归 ppe0 槽位）
#   C. IPQ95XX 6.18 qcom_ppe 单引擎：/sys/kernel/debug/ppe/active_flows = "v4 v6 total/容量"
#      （活跃流即硬件绑定流 → b/bv4/bv6 = v4/v6 活跃数；仅该布局设备走到此分支）
_ad_ppe_json() {
    local F=/tmp/adash-ppe.json hw ent p bf bent t a b ba bb t0 a0 b0 ba0 bb0 t1 a1 b1 ba1 bb1 af
    if [ -s "$F" ] && [ $(( $(date +%s) - $(stat -c %Y "$F" 2>/dev/null || echo 0) )) -lt 60 ]; then
        cat "$F"; return
    fi
    hw=$(uci -q get firewall.@defaults[0].flow_offloading_hw 2>/dev/null)
    [ "$hw" = "1" ] || hw=0
    t0=0; a0=0; b0=0; ba0=0; bb0=0; t1=0; a1=0; b1=0; ba1=0; bb1=0
    if [ -r /sys/kernel/debug/ppe0/entries ] || [ -r /sys/kernel/debug/ppe1/entries ]; then
        for p in /sys/kernel/debug/ppe0/entries /sys/kernel/debug/ppe1/entries; do
            [ -r "$p" ] || continue
            ent=$(cat "$p" 2>/dev/null); t=0; a=0; b=0; ba=0; bb=0
            [ -n "$ent" ] && { t=$(printf '%s\n' "$ent" | wc -l); a=$(printf '%s\n' "$ent" | grep -c 'IPv4'); b=$(printf '%s\n' "$ent" | grep -c 'IPv6'); }
            bf=$(printf '%s' "$p" | sed 's|/entries$|/bind|')
            if [ -r "$bf" ]; then
                bent=$(cat "$bf" 2>/dev/null)
                [ -n "$bent" ] && { ba=$(printf '%s\n' "$bent" | grep -c 'IPv4'); bb=$(printf '%s\n' "$bent" | grep -c 'IPv6'); }
            fi
            case "$p" in
                *ppe0*) t0=$t; a0=$a; b0=$b; ba0=$ba; bb0=$bb ;;
                *ppe1*) t1=$t; a1=$a; b1=$b; ba1=$ba; bb1=$bb ;;
            esac
        done
    elif [ -r /sys/kernel/debug/mtk_ppe/entries ]; then
        ent=$(cat /sys/kernel/debug/mtk_ppe/entries 2>/dev/null)
        [ -n "$ent" ] && { t0=$(printf '%s\n' "$ent" | wc -l); a0=$(printf '%s\n' "$ent" | grep -ci 'ip4'); b0=$(printf '%s\n' "$ent" | grep -ci 'ip6'); }
    elif [ -r /sys/kernel/debug/ppe/active_flows ]; then
        af=$(cat /sys/kernel/debug/ppe/active_flows 2>/dev/null)
        if [ -n "$af" ]; then
            set -- $af
            a0=$1; b0=$2; t0=${3%%/*}
            ba0=$1; bb0=$2
            _ad_pcap=${3##*/}
        fi
    fi
    [ -n "${_ad_pcap:-}" ] || _ad_pcap=0
    # PPE 硬件资源池占用（host/next-hop 表；IPQ95xx: flow 4096/host 6144/nexthop 2560）
    rs=$(cat /sys/kernel/debug/ppe/resource_stats 2>/dev/null)
    _hrow=$(printf '%s\n' "$rs" | sed -n 's/.*host active:\([0-9]*\) capacity:\([0-9]*\).*/\1 \2/p' | head -1)
    _nrow=$(printf '%s\n' "$rs" | sed -n 's/.*nexthop active:\([0-9]*\) capacity:\([0-9]*\).*/\1 \2/p' | head -1)
    set -- ${_hrow:-- -}; _ha=$1; _hc=$2
    set -- ${_nrow:-- -}; _na=$1; _nc=$2
    # b = 绑定合计（view「绑定/表项」数据源；原 statusppe 链路无此字段恒 0，此处修正）
    local bn0=$((ba0+bb0)) bn1=$((ba1+bb1))
    printf '{"hw":%d,"cpu":-1,"cpu_avg":-1,"usr":0,"sys":0,"cap":%s,"ppe0":{"t":%d,"v4":%d,"v6":%d,"b":%d,"bv4":%d,"bv6":%d},"ppe1":{"t":%d,"v4":%d,"v6":%d,"b":%d,"bv4":%d,"bv6":%d},"host":{"a":%d,"c":%d},"nh":{"a":%d,"c":%d},"ts":%d}\n' \
        "$hw" "${_ad_pcap:-0}" "$t0" "$a0" "$b0" "$bn0" "$ba0" "$bb0" "$t1" "$a1" "$b1" "$bn1" "$ba1" "$bb1" "$_ha" "$_hc" "$_na" "$_nc" "$(date +%s)" > "$F.tmp.$$" 2>/dev/null \
        && mv -f "$F.tmp.$$" "$F" 2>/dev/null
    chmod 644 "$F" 2>/dev/null
    cat "$F" 2>/dev/null || echo '{"hw":0,"cpu":-1,"cpu_avg":-1}'
}
# conntrack 聚合 + 协议统计（v4.52 合并）：30s 视图驱动缓存，一次扫描出两份数据——
#   ① per-IP：ip|up|dn|cn（客户端聚合源）  ② 协议 8 元组（连接数统计卡）
# 原两段各扫一遍全表（224+131ms）且 25s/30s 双缓存相位漂移隔次双倍付费；合并后单次
# ~200ms、每 30s 至多扫一遍，无人查看时零成本。
_ad_ct_agg_ensure() {
    local F=/tmp/adash-ct-agg
    # v4.52：本机 busybox 无 stat applet（stat -c %Y 恒失败→旧守卫每次都全表扫描），
    #       改 .ts 时间戳文件判鲜（与响应缓存同款模式，read 内建零 spawn）
    if [ -s "$F" ] && [ -s "$F.ts" ]; then
        _ctsv=""
        read -r _ctsv < "$F.ts" 2>/dev/null
        case "$_ctsv" in
            ''|*[!0-9]*) : ;;
            *) [ $(( NOW - _ctsv )) -lt 30 ] && return 0 ;;
        esac
    fi
    [ -f /proc/net/nf_conntrack ] || { : > "$F"; : > /tmp/adash-ct-stats; echo "$NOW" > "$F.ts"; return 0; }
    # 内网判定输入（OWN/LAN6/活跃阈值，仅扫描时计算）
    _own_ip=$(ip -o addr show 2>/dev/null | awk '{
      for(i=1;i<=NF;i++) if($i=="inet"||$i=="inet6"){a=$(i+1); sub(/\/.*/,"",a); sub(/%.*/,"",a); if(a!=""&&a!="::1"&&a!="127.0.0.1") print a}
    }' | tr '\n' '|')
    _lan6=$(ip -o addr show 2>/dev/null | awk '/inet6/{
      a=$4; sub(/\/.*/,"",a); sub(/%.*/,"",a)
      if(a==""||a=="::1"||index(a,"fe80")==1) next
      n=split(a,h,":"); p=h[1]":"h[2]":"h[3]":"h[4]
      if(p!=""&&p!=":::") print p
    }' | tr '\n' '|')
    _act_th=$(( $(cat /proc/sys/net/netfilter/nf_conntrack_tcp_timeout_established 2>/dev/null || echo 7440) * 2 / 3 ))
    awk -v AGGT="$F.tmp.$$" -v STFT="/tmp/adash-ct-stats.tmp.$$" \
        -v OWN="|${_own_ip}" -v LAN6="|${_lan6}" -v ACT="${_act_th}" '
      function canon(x,  n,g,i,out){n=split(x,g,":");for(i=1;i<=n;i++){if(g[i]=="")g[i]="0";while(length(g[i])<4)g[i]="0" g[i]};out=g[1];for(i=2;i<=n;i++)out=out":"g[i];return out}
      function z(s){ gsub(/^0+/,"",s); return (s==""?"0":s) }
      function p4(s, n,h){ n=split(s,h,":"); return z(h[1])":"z(h[2])":"z(h[3])":"z(h[4]) }
      function is_int(ip){
        if(ip=="") return 1
        if(index(OWN,"|" ip "|")>0) return 1
        if(index(ip,".")>0){
          if(substr(ip,1,3)=="10.") return 1
          if(substr(ip,1,4)=="127.") return 1
          if(substr(ip,1,8)=="169.254.") return 1
          if(substr(ip,1,8)=="192.168.") return 1
          if(substr(ip,1,4)=="172."){
            seg=substr(ip,5)+0
            if(seg>=16&&seg<=31) return 1
          }
          if(substr(ip,1,4)=="100."){
            seg=substr(ip,5)+0
            if(seg>=64&&seg<=127) return 1
          }
          return 0
        }
        if(substr(ip,1,5)=="fe80:"||ip=="::1") return 1
        if(substr(ip,1,2)=="fc"||substr(ip,1,2)=="fd") return 1
        if(index(LAN6,"|" p4(ip) "|")>0) return 1
        return 0
      }
      {
        s1="";b1="";b2="";ctst="";proto="";d1="";off=0;assured=0
        for(i=1;i<=NF;i++){
          if($i~/^src=/){if(s1=="")s1=substr($i,5)}
          else if($i~/^dst=/&&d1=="")d1=substr($i,5)
          else if($i~/^bytes=/){if(b1=="")b1=substr($i,7);else if(b2=="")b2=substr($i,7)}
          # 首个命中生效（TCP 裸词状态在 $6，若不判空会被行尾 [ASSURED] 覆盖 → 连接数漏计）
          if(ctst==""&&($i=="ESTABLISHED"||$i=="OFFLOAD"||$i=="[ESTABLISHED]"||$i=="[OFFLOAD]"||$i=="[ASSURED]")){ctst=$i;gsub(/[][]/,"",ctst)}
          if($i=="[OFFLOAD]"||$i=="OFFLOAD")off=1
          if($i=="[ASSURED]")assured=1
        }
        proto=$3
        if(s1=="")next
        if(index(s1,":"))s1=canon(s1)
        up[s1]+=b1;dn[s1]+=b2
        if(ctst=="ESTABLISHED"||ctst=="OFFLOAD"||(ctst=="ASSURED"&&proto=="udp"))cn[s1]++
        # —— 协议 8 元组（原独立扫描，v4.52 并入同一循环）——
        # TCP 活跃=ESTABLISHED/OFFLOAD；剩余超时≥ACT(2/3 满值)=近期有流量=活跃
        active=0
        if(proto=="tcp"){
          tcp++
          if($6=="ESTABLISHED"||off){tcp_e++; active=1
            if($5+0>=ACT) tcp_act++; else tcp_idle++
          }
        } else if(proto=="udp"){
          udp++
          if(assured||off){udp_e++; active=1}
        } else if(proto=="icmp"||proto=="icmpv6"){
          icmp++; active=1
        }
        if(active && (!is_int(s1) || !is_int(d1))) ext++
      }
      END{
        for(k in up)printf "%s|%.0f|%.0f|%d\n",k,up[k]+0,dn[k]+0,cn[k]+0 > AGGT
        printf "%d %d %d %d %d %d %d %d\n",tcp_e+0,tcp+0,udp_e+0,udp+0,icmp+0,ext+0,tcp_act+0,tcp_idle+0 > STFT
      }' /proc/net/nf_conntrack 2>/dev/null \
        && mv -f "$F.tmp.$$" "$F" && mv -f /tmp/adash-ct-stats.tmp.$$ /tmp/adash-ct-stats 2>/dev/null \
        && echo "$NOW" > "$F.ts" \
        || rm -f "$F.tmp.$$" /tmp/adash-ct-stats.tmp.$$ 2>/dev/null
    return 0
}

# ===== 查询端点分发 =====
# ===== 常驻采样器快照（v4.33）=====
# 由 adash-sampler 以固定节奏（默认 2s）写入 /tmp/adash-snap。
# 优先使用快照：温度/占用按固定节奏采样，不受本次请求重活（nft/conntrack）污染；
# 快照缺失或过期（>12s）时回退到 CGI 内联采样，保证单独装本包也能正常工作。
SNAP_FILE=/tmp/adash-snap
SNAP_MAX_AGE=12
_sm_snap_fresh=0
_sm_snap_cpu=""; _sm_snap_temp_milli=""; _sm_snap_disk_milli=""; _sm_snap_fmin=""; _sm_snap_fmax=""
_sm_snap_l1=""; _sm_snap_l5=""; _sm_snap_l15=""
if [ -s "$SNAP_FILE" ]; then
    _sm_snap_ts=0
    while IFS='=' read -r _sk _sv; do
        case "$_sk" in
            ts) _sm_snap_ts=$_sv ;;
            cpu) _sm_snap_cpu=$_sv ;;
            temp) _sm_snap_temp_milli=$_sv ;;
            disk) _sm_snap_disk_milli=$_sv ;;
            fmin) _sm_snap_fmin=$_sv ;;
            fmax) _sm_snap_fmax=$_sv ;;
            l1) _sm_snap_l1=$_sv ;;
            l5) _sm_snap_l5=$_sv ;;
            l15) _sm_snap_l15=$_sv ;;
        esac
    done < "$SNAP_FILE"
    case "$_sm_snap_ts" in ''|*[!0-9]*) _sm_snap_ts=0 ;; esac
    _sm_snap_age=$((NOW - _sm_snap_ts))
    [ "$_sm_snap_ts" -gt 0 ] && [ "$_sm_snap_age" -ge 0 ] && [ "$_sm_snap_age" -lt "$SNAP_MAX_AGE" ] && _sm_snap_fresh=1
fi
_sm_now_temp() {
    if [ "$_sm_snap_fresh" = 1 ]; then
        case "$_sm_snap_temp_milli" in
            ''|*[!0-9]*) ;;
            *)
                [ "$_sm_snap_temp_milli" -gt 0 ] && { awk -v v="$_sm_snap_temp_milli" 'BEGIN{printf "%.1f", v/1000}'; return; }
                ;;
        esac
    fi
    _sm_sys_hist_temp
}
_sm_now_disk() {
    if [ "$_sm_snap_fresh" = 1 ]; then
        case "$_sm_snap_disk_milli" in
            ''|*[!0-9]*) ;;
            *)
                [ "$_sm_snap_disk_milli" -gt 0 ] && { awk -v v="$_sm_snap_disk_milli" 'BEGIN{printf "%.1f", v/1000}'; return; }
                ;;
        esac
    fi
    _sm_sys_hist_disk
}
_sm_cpu_temp_now=$(_sm_now_temp)
_sm_disk_temp_now=$(_sm_now_disk)
# v4.51：PWM 风扇实时转速（hwmon name 含 fan 的 fan1_input，SBE1V1K 为 pwmfan）；无风扇返回空
_sm_now_fan() {
    local h t
    for h in /sys/class/hwmon/hwmon*; do
        [ -f "$h/name" ] || continue
        case "$(cat "$h/name" 2>/dev/null)" in
            *fan*)
                [ -f "$h/fan1_input" ] || continue
                t=$(cat "$h/fan1_input" 2>/dev/null)
                case "$t" in ''|*[!0-9]*) ;; *) echo "$t"; return ;; esac
                ;;
        esac
    done
    echo ""
}
_sm_fan_rpm_now=$(_sm_now_fan)
_qs_accumulate=$(echo "$QUERY_STRING" | sed -n 's/^accumulate=\([^&]*\).*/\1/p')
if [ -n "$_qs_accumulate" ]; then
    # cron 每分钟调用：只累计不返回数据（客户端 nft 动态 set 差分 + sys_hist 采样 + PPPoE 记账）
    # v4.52：月/日分类归档引擎裁撤（proto_accumulate/wan_accumulate 移除——PPE 硬转发下
    #       分类计数不可信、月流量卡已删）；分类种子照旧维护 nft set 生态
    sys_hist_sample
    client_accumulate
    _sm_sets_seed
    _sm_pppoe_acct_tick
    echo '{"result":"ok"}'
    exit 0
fi
_qs_sys_hist=$(echo "$QUERY_STRING" | sed -n 's/^sys_hist=\([^&]*\).*/\1/p')
if [ -n "$_qs_sys_hist" ]; then
    sys_hist_json
    exit 0
fi

# ===== 客户端连接详情查询（?client=IP 或 ?mac=MAC）=====
# ?mac=MAC 时自动查找该 MAC 的所有 IP（v4+v6 邻居表），返回所有 conntrack 连接
QUERY_VAL=""
QUERY_MODE=""
if [ -n "$QUERY_STRING" ]; then
    _qs_mac=$(echo "$QUERY_STRING" | sed -n 's/^mac=\([^&]*\).*/\1/p')
    _qs_ip=$(echo "$QUERY_STRING" | sed -n 's/^client=\([^&]*\).*/\1/p')
    if [ -n "$_qs_mac" ]; then
        QUERY_MODE="mac"; QUERY_VAL=$(printf '%b' "$(echo "$_qs_mac" | sed 's/%/\\x/g')")
    elif [ -n "$_qs_ip" ]; then
        QUERY_MODE="ip"; QUERY_VAL=$(printf '%b' "$(echo "$_qs_ip" | sed 's/%/\\x/g')")
    fi
fi
if [ -n "$QUERY_MODE" ]; then
    CTF=/proc/net/nf_conntrack
    [ -f "$CTF" ] || CTF=/dev/null
    # 如果是 MAC 模式，先查邻居表获取该 MAC 的所有 IP
    if [ "$QUERY_MODE" = "mac" ]; then
        QUERY_IPS=$(ip neigh show 2>/dev/null | grep -i "$QUERY_VAL" | grep -v fe80 | awk '{print $1}' | tr '\n' ' ')
    else
        QUERY_IPS="$QUERY_VAL"
    fi
    conns=$(awk -v ips="$QUERY_IPS" -v CTF="$CTF" '
    function stripz(g){while(length(g)>1&&substr(g,1,1)=="0")g=substr(g,2);return g}
    function canon(v,  p,h,t,hn,tn,i,g,out){
      v=tolower(v)
      if(v~/::/){split(v,p,"::");hn=0;tn=0;if(p[1]!="")hn=split(p[1],h,":");if(p[2]!="")tn=split(p[2],t,":");for(i=1;i<=hn;i++)g[i]=h[i];for(i=1;i<=8-hn-tn;i++)g[hn+i]="0";for(i=1;i<=tn;i++)g[8-tn+i]=t[i]}
      else split(v,g,":")
      out="";for(i=1;i<=8;i++){if(i>1)out=out":";out=out stripz(g[i])};return out
    }
    BEGIN {
        first = 1; printf "["
        nip = split(ips, iparr, " ")
        for (i = 1; i <= nip; i++) {
            ip = iparr[i]
            if (index(ip, ":")) ip = canon(ip)
            ipset[ip] = 1
        }
    }
    {
        proto = $3; nf = NF
        state = ""
        for (i = 1; i <= nf; i++) {
            if ($i ~ /^(ESTABLISHED|TIME_WAIT|CLOSE_WAIT|CLOSE|SYN_RECV|FIN_WAIT|LISTEN|NONE|OFFLOAD|\[ESTABLISHED\]|\[TIME_WAIT\]|\[CLOSE_WAIT\]|\[CLOSE\]|\[SYN_RECV\]|\[FIN_WAIT\]|\[OFFLOAD\]|\[ASSURED\])$/) {
                if (state == "") { state = $i; gsub(/[][]/, "", state) }
            }
        }
        src = ""; dst = ""; sport = ""; dport = ""; pkts = "0"; byts = "0"
        for (i = 1; i <= nf; i++) {
            if ($i ~ /^src=/ && src == "") { src = substr($i, 5) }
            if ($i ~ /^dst=/ && dst == "") { dst = substr($i, 5) }
            if ($i ~ /^sport=/ && sport == "") { sport = substr($i, 7) }
            if ($i ~ /^dport=/ && dport == "") { dport = substr($i, 7) }
        }
        if (src == "") next
        # IPv6 地址规范化后匹配
        csrc = src
        if (index(csrc, ":")) csrc = canon(csrc)
        if (csrc in ipset) {
            # 只返回活跃连接（TCP=ESTABLISHED+OFFLOAD, UDP=ASSURED+OFFLOAD），与列表口径一致
        if (state != "ESTABLISHED" && state != "OFFLOAD" && !(state == "ASSURED" && proto == "udp")) next
            for (i = 1; i <= nf; i++) {
                if ($i ~ /^packets=/) { pkts = substr($i, 9); break }
            }
            for (i = 1; i <= nf; i++) {
                if ($i ~ /^bytes=/) { byts = substr($i, 7); break }
            }
            svc = dport
            if (dport == "80") svc = "HTTP"
            else if (dport == "443") svc = "HTTPS"
            else if (dport == "53") svc = "DNS"
            else if (dport == "22") svc = "SSH"
            else if (dport == "8080") svc = "HTTP-Alt"
            else if (dport == "123") svc = "NTP"
            else if (dport == "1900") svc = "SSDP"
            else if (dport == "5353") svc = "mDNS"
            if (!first) printf ","
            first = 0
            printf "{\"proto\":\"%s\",\"state\":\"%s\",\"dst\":\"%s\",\"dport\":\"%s\",\"sport\":\"%s\",\"svc\":\"%s\",\"pkts\":%s,\"bytes\":%s}", proto, state, dst, dport, sport, svc, pkts+0, byts+0
        }
    }
    END { printf "]" }
    ' "$CTF" 2>/dev/null)
    echo "$conns"
    exit 0
fi

PREV_TS=0; PREV_NET=""; PREV_CLIENT=""
if [ -f "$STATE" ]; then
    PREV_TS=$(grep -o '"ts":[0-9]*' "$STATE" 2>/dev/null | head -1 | cut -d: -f2)
    PREV_NET=$(grep -o '"net":"[^"]*"' "$STATE" 2>/dev/null | head -1 | cut -d: -f2- | tr -d '"')
    PREV_CLIENT=$(grep -o '"clients":"[^"]*"' "$STATE" 2>/dev/null | head -1 | cut -d: -f2- | tr -d '"')
fi
# 注：v4.6 速率计算移至前端，CGI 不再使用 DT/PREV_NET/PREV_CLIENT 做速率计算；
# 但仍需保存 net/clients 状态供客户端累计流量等使用
DT=$((NOW - PREV_TS))
[ "$DT" -lt 1 ] && DT=1

# ===== 响应缓存（v4.49 引入；v4.52 命中检查已前置至脚本头部 NOW= 之后）：此处为
#      冷路径重建入口——先写 ts 占位，结尾 mv 原子替换；25sTTL 页面 5s 轮询大部分命中 =====
_sm_cache=/tmp/adash-cache.json
_sm_cts=/tmp/adash-cache.ts
echo "$NOW" > "$_sm_cts"
# v4.50 修复：响应缓存保存 fd 9→7——proto/PPPoE/client 三个 flock 都用
#      fd 9 当锁句柄（exec 9>/tmp/adash-*.lock），顶层 PPPoE 记账段在每次重建
#      都执行，exec 9> 会把保存的 stdout 顶掉；结尾 exec 1>&9 恢复出的 stdout
#      指向锁文件，整个 8KB JSON 被 cat 进 /tmp/adash-pppoe-acct.lock 而非
#      发给浏览器 → 重建响应全空、?live=1 实时端点必空 → 仪表盘数字冻结
exec 7>&1
exec > "$_sm_cache.tmp.$$"

# ===== 系统 =====
hostname=$(cat /proc/sys/kernel/hostname 2>/dev/null)
kernel=$(uname -r 2>/dev/null)
firmware=$(. /etc/openwrt_release 2>/dev/null; printf '%s' "$DISTRIB_DESCRIPTION")
firmware=$(printf '%s' "$firmware" | tr -d '\r\n\\"')
uptime_s=$(awk '{printf "%.0f", $1}' /proc/uptime 2>/dev/null)
load1=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
load5=$(awk '{print $2}' /proc/loadavg 2>/dev/null)
load15=$(awk '{print $3}' /proc/loadavg 2>/dev/null)
board=$(cat /tmp/sysinfo/board_name 2>/dev/null || echo "unknown")
# CPU 型号：x86 取 cpuinfo 的 model name；ARM 的 model name 仅是「ARMv8 Processor rev 4」，
# 改用 sysinfo 板级型号 + CPU part 解码（如 0xd03=Cortex-A53），否则对用户无意义。
cpu_model=$(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2 | sed 's/^ *//')
case "$cpu_model" in
    ''|*ARMv[0-9]*|*ARM*Processor*)
        _armpart=$(awk -F: '/^CPU part/{gsub(/ /,"",$2); print $2; exit}' /proc/cpuinfo 2>/dev/null)
        case "$_armpart" in
            0xd03) _armname="Cortex-A53" ;;
            0xd05) _armname="Cortex-A55" ;;
            0xd07) _armname="Cortex-A57" ;;
            0xd08) _armname="Cortex-A72" ;;
            0xd09) _armname="Cortex-A73" ;;
            0xd0a) _armname="Cortex-A75" ;;
            0xd0b) _armname="Cortex-A76" ;;
            0xd0d) _armname="Cortex-A77" ;;
            0xd41) _armname="Cortex-A78" ;;
            0xd44) _armname="Cortex-X1" ;;
            0xd46) _armname="Cortex-A510" ;;
            0xd47) _armname="Cortex-A710" ;;
            0xd48) _armname="Cortex-X2" ;;
            0xd4d) _armname="Cortex-A715" ;;
            0xd4e) _armname="Cortex-X3" ;;
            0xd81) _armname="Cortex-A720" ;;
            0xd82) _armname="Cortex-X4" ;;
            *) [ -n "$_armpart" ] && _armname="ARM $_armpart" ;;
        esac
        _sysmodel=$(cat /tmp/sysinfo/model 2>/dev/null)
        if [ -n "$_sysmodel" ]; then
            cpu_model="$_sysmodel"
            [ -n "$_armname" ] && cpu_model="$cpu_model ($_armname)"
        elif [ -n "$_armname" ]; then
            cpu_model="$_armname"
        else
            cpu_model="${cpu_model:-unknown}"
        fi
        ;;
esac
[ -n "$cpu_model" ] || cpu_model="unknown"
cpu_cores=$(grep -c processor /proc/cpuinfo 2>/dev/null || echo 1)

# CPU 当前频率（v4.30）：读各核 scaling_cur_freq（kHz），输出 MHz 的 min/max
cpu_freq_min=0
cpu_freq_max=0
for _sf in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq; do
        [ -f "$_sf" ] || continue
        _khz=$(cat "$_sf" 2>/dev/null)
        case "$_khz" in ''|*[!0-9]*) continue ;; esac
        _mhz=$((_khz / 1000))
        [ "$_mhz" -gt 0 ] || continue
        if [ "$cpu_freq_min" -eq 0 ] || [ "$_mhz" -lt "$cpu_freq_min" ]; then
                cpu_freq_min=$_mhz
        fi
        if [ "$_mhz" -gt "$cpu_freq_max" ]; then
                cpu_freq_max=$_mhz
        fi
done
if [ "$cpu_freq_max" -eq 0 ]; then
        # 无 cpufreq 驱动（MT7986 等 ARM SoC）：回退 debugfs 时钟树
        for _cf in /sys/kernel/debug/clk/armpll/clk_rate /sys/kernel/debug/clk/cpu/clk_rate \
                /sys/kernel/debug/clk/cpu0/clk_rate /sys/kernel/debug/clk/cpu_pll/clk_rate; do
                [ -r "$_cf" ] || continue
                _khz=$(cat "$_cf" 2>/dev/null)
                case "$_khz" in ''|*[!0-9]*) continue ;; esac
                _mhz=$((_khz / 1000000))
                [ "$_mhz" -gt 0 ] || continue
                cpu_freq_min=$_mhz
                cpu_freq_max=$_mhz
                break
        done
fi
if [ "$cpu_freq_max" -eq 0 ]; then
        _mhz=$(awk -F: '/^cpu MHz/{gsub(/ /,"",$2); printf "%.0f\n",$2; exit}' /proc/cpuinfo 2>/dev/null)
        case "$_mhz" in ''|*[!0-9]*) _mhz=0 ;; esac
        cpu_freq_min=$_mhz
        cpu_freq_max=$_mhz
fi
cpu_freq=$cpu_freq_max

# CPU 温度：入口处分发前已采样（v4.31），避免后面 nft/客户端累计把读数抬高
temp_c=${_sm_cpu_temp_now:-null}
case "$temp_c" in ''|0) temp_c="null" ;; esac
disk_c=${_sm_disk_temp_now:-null}
case "$disk_c" in ''|0) disk_c="null" ;; esac
fan_rpm=${_sm_fan_rpm_now:-null}
case "$fan_rpm" in ''|*[!0-9]*) fan_rpm="null" ;; esac

# CPU 使用率：跨请求差分采样（v4.8）
# BusyBox sleep 不支持小数秒，请求内 sleep 0.5 必然失败（日志刷屏 + 窗口退化 ~1ms，
# 4 核量化出 0/25/50/75/100% 失真值）。改为本次 /proc/stat 计数器与上次请求存档做差，
# 采样窗口即轮询间隔（约 2s）；窗口不足 1s（delta < 核数×100 tick）或计数器回绕时沿用上次结果。
# 状态文件 /tmp/adash-cpu.state：total idle usage 三个整数，原子替换写入
cpu_usage=0
CPU_STATE=/tmp/adash-cpu.state
read -r _ cu_u2 cu_n2 cu_s2 cu_i2 cu_w2 cu_q2 cu_sq2 cu_st2 _ _ < /proc/stat 2>/dev/null
if [ -n "$cu_i2" ]; then
    cu_tot2=$((cu_u2 + cu_n2 + cu_s2 + cu_i2 + cu_w2 + cu_q2 + cu_sq2 + cu_st2))
    cu_idl2=$((cu_i2 + cu_w2))
    cu_pt=0; cu_pi=0; cu_pu=0
    [ -f "$CPU_STATE" ] && read -r cu_pt cu_pi cu_pu < "$CPU_STATE" 2>/dev/null
    case "$cu_pt" in ''|*[!0-9]*) cu_pt=0 ;; esac
    case "$cu_pi" in ''|*[!0-9]*) cu_pi=0 ;; esac
    case "$cu_pu" in ''|*[!0-9]*) cu_pu=0 ;; esac
    cu_dt=$((cu_tot2 - cu_pt))
    cu_di=$((cu_idl2 - cu_pi))
    cu_min=$((cpu_cores * 100))
    if [ "$cu_pt" -eq 0 ] || [ "$cu_dt" -lt 0 ]; then
        # 首次运行 / 计数器回绕（重启）：仅重建基线，沿用上次结果
        cpu_usage=$cu_pu
    elif [ "$cu_dt" -ge "$cu_min" ]; then
        cpu_usage=$(( (cu_dt - cu_di) * 100 / cu_dt ))
    else
        # 窗口不足 1s（并发轮询密集）：沿用上次结果
        cpu_usage=$cu_pu
    fi
    printf '%s %s %s\n' "$cu_tot2" "$cu_idl2" "$cpu_usage" > "$CPU_STATE.$$" 2>/dev/null && mv -f "$CPU_STATE.$$" "$CPU_STATE" 2>/dev/null
    rm -f "$CPU_STATE.$$" 2>/dev/null
fi

# 采样器快照优先（v4.33）：固定节奏采样，覆盖上面的内联采样结果（缺失/过期时保留回退值）
if [ "$_sm_snap_fresh" = 1 ]; then
    case "$_sm_snap_cpu" in ''|*[!0-9]*) ;; *) cpu_usage=$_sm_snap_cpu ;; esac
    case "$_sm_snap_fmax" in
        ''|*[!0-9]*) ;;
        *) cpu_freq_min=$_sm_snap_fmin; cpu_freq_max=$_sm_snap_fmax; cpu_freq=$_sm_snap_fmax ;;
    esac
    [ -n "$_sm_snap_l1" ] && load1=$_sm_snap_l1
    [ -n "$_sm_snap_l5" ] && load5=$_sm_snap_l5
    [ -n "$_sm_snap_l15" ] && load15=$_sm_snap_l15
fi

# ===== 内存 =====
mem_total=0; mem_free=0; mem_avail=0; mem_cached=0; mem_buf=0
while read -r line; do
    case "$line" in
        MemTotal:*) mem_total=$(echo "$line" | awk '{print $2}') ;;
        MemFree:*) mem_free=$(echo "$line" | awk '{print $2}') ;;
        MemAvailable:*) mem_avail=$(echo "$line" | awk '{print $2}') ;;
        Cached:*) mem_cached=$(echo "$line" | awk '{print $2}') ;;
        Buffers:*) mem_buf=$(echo "$line" | awk '{print $2}') ;;
    esac
done < /proc/meminfo 2>/dev/null
mem_used=$((mem_total - mem_avail))

# ===== 协议统计 =====
# v4.10：/proc/net/snmp 单次 awk 提取（此前 12 个 grep/echo|awk 进程 spawn）
# 各协议两行（表头+数值），awk 后行覆盖前行 → 取到数值行，与旧 tail -1 语义一致
proto_tcp_curr=0; proto_tcp_total=0; proto_udp=0; proto_icmp=0; proto_ip_total=0
proto_tcp_ret=0; proto_udp_ret=0
set -- $(awk '
  /^Tcp:/{t10=$10;t11=$11;t13=$13}
  /^Udp:/{u2=$2;u4=$4}
  /^Icmp:/{i2=$2}
  /^Ip:/{p3=$3}
  END{print t10+0,t11+0,t13+0,u2+0,u4+0,i2+0,p3+0}' /proc/net/snmp 2>/dev/null)
[ -n "${1:-}" ] && proto_tcp_curr=$1
[ -n "${2:-}" ] && proto_tcp_total=$2
[ -n "${3:-}" ] && proto_tcp_ret=$3
[ -n "${4:-}" ] && proto_udp=$4
[ -n "${5:-}" ] && proto_udp_ret=$5
[ -n "${6:-}" ] && proto_icmp=$6
[ -n "${7:-}" ] && proto_ip_total=$7
ct_total=0
[ -f /proc/sys/net/netfilter/nf_conntrack_count ] && ct_total=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0)
[ -z "$ct_total" ] && ct_total=0
ct_max=0
[ -f /proc/sys/net/netfilter/nf_conntrack_max ] && ct_max=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || echo 0)
[ -z "$ct_max" ] && ct_max=0

# conntrack 协议分布（v4.52：并入 ct-agg 单次扫描，此处只读缓存文件；数字鲜度≤30s，
# 与响应缓存叠加后卡片数据鲜度和原设计一致）
# TCP 活跃 = ESTABLISHED 或 [OFFLOAD]；UDP 活跃 = [ASSURED] 或 [OFFLOAD]；
# 外部连接 = 活跃连接中原始 src 或 dst 任一为公网
_ad_ct_agg_ensure
if [ -s /tmp/adash-ct-stats ]; then
    _proto_stats=$(cat /tmp/adash-ct-stats)
else
    _proto_stats="0 0 0 0 0 0 0 0"
fi
# v4.52：8 元组纯 shell 拆分（原 6×echo|awk 管道，12 spawn）
set -- $_proto_stats
ct_tcp_estab=${1:-0}; ct_tcp_total=${2:-0}; ct_udp=${3:-0}; ct_udp_total=${4:-0}
ct_icmp=${5:-0}; ct_external=${6:-0}; ct_tcp_act=${7:-0}; ct_tcp_idle=${8:-0}

# ===== 网络接口（物理 + LAN + WAN + WiFi + pppoe*）=====
# v4.10 性能优化：所有 sysfs/ip/uci 读取批量预取为 shell 变量，循环内零进程 spawn
# （此前每接口 10+ spawn，且每个 ethX 跑两次 uci show network —— 是轮询开销主因）
net_ifs="[]"
net_lines=""
net_state=""

# 1) 全部接口计数器：一次 awk 读 /proc/net/dev（与 /sys/class/net/*/statistics 同源）
eval "$(awk 'NR>2{n=$1;sub(/:$/,"",n);gsub(/[^a-zA-Z0-9_]/,"_",n);
  printf "IFC_%s=\"%s %s %s %s\"\n", n, $2, $10, $3, $11}' /proc/net/dev 2>/dev/null)"
# 2) operstate：一次 awk 扫全部 sysfs 文件（carrier 不能 bulk 读 —— 虚拟设备如 dummy0
#    的 carrier 读返回 EINVAL 会让 BusyBox awk 直接退出，故 carrier 在循环内按需 cat）
eval "$(awk '{f=FILENAME;sub(/.*\/net\//,"",f);sub(/\/operstate$/,"",f);gsub(/[^a-zA-Z0-9_]/,"_",f);
  printf "OPST_%s=\"%s\"\n", f, $0}' /sys/class/net/*/operstate 2>/dev/null)"
# 3) 地址：ip -o 一次全取（v4 取前 3 个、v6 全局取前 2 个，与旧逐口解析口径一致；
#    PPP peer 行 $4 为裸 IP，等价旧正则的可选掩码语义）
eval "$(ip -o -4 addr show 2>/dev/null | awk '{n=$2;gsub(/[^a-zA-Z0-9_]/,"_",n);a=$4;sub(/ .*/,"",a);
  if(A4[n]=="")A4[n]=a; else if(c4[n]<2)A4[n]=A4[n]", "a; c4[n]++}
  END{for(n in A4)printf "ADR4_%s=\"%s\"\n", n, A4[n]}')"
eval "$(ip -o -6 addr show 2>/dev/null | awk '$5=="scope"&&$6=="global"{n=$2;gsub(/[^a-zA-Z0-9_]/,"_",n);
  if(A6[n]=="")A6[n]=$4; else if(c6[n]<1)A6[n]=A6[n]", "$4; c6[n]++}
  END{for(n in A6)printf "ADR6_%s=\"%s\"\n", n, A6[n]}')"
# 4) UCI 一次性预取：PPPoE 各接口的底层 device + 全部 device 引用
_pppoe_base_devs=""
for _sec in $(uci show network 2>/dev/null | sed -n "s/^network\.\([^.]*\)\.proto='pppoe'/\1/p"); do
    _pd=$(uci get "network.$_sec.device" 2>/dev/null)
    [ -n "$_pd" ] && { _pppoe_base_devs="$_pppoe_base_devs $_pd"; eval "PPPB_${_sec//-/_}='$_pd'"; }
done
_uci_all=$(uci show network 2>/dev/null | grep "device=")

if command -v flock >/dev/null 2>&1; then
    exec 9>/tmp/adash-pppoe-acct.lock
    flock -n -x 9 2>/dev/null || true
fi
_sm_pppoe_acct_load

for iface_dir in /sys/class/net/*; do
    iface=$(basename "$iface_dir")
    case "$iface" in
        eth*|wlan*|ra*|br-lan|wan*|br-wan|pppoe-*|ppp-*|lan*) ;;
        *) continue ;;
    esac
    _ad_show=$iface
    case "$iface" in
        lan*)
            _ad_lsec=$(printf '%s\n' "$_uci_all" | sed -n "s/^network\.\([^.]*\)\.device='$iface'\$/\1/p" | head -1)
            # v19：DSA 桥成员口（无 uci device 引用，如 SBE1V1K lan1-3）不再跳过——
            # 端口卡需展示物理口；拓扑右列只画有 IP 的接口，多余物理口自然不进拓扑
            [ -n "$_ad_lsec" ] && [ "$_ad_lsec" != "lan" ] && _ad_show=$_ad_lsec
            ;;
    esac
    _m=${iface//-/_}; _m=${_m//./_}
    # 状态（operstate 为 unknown/down 时参考 carrier，同旧逻辑；carrier 逐口读，
    # 虚拟设备读返回 EINVAL 时 cat 失败→空值→不误判）
    eval "operstate=\${OPST_${_m}:-unknown}"
    if [ "$operstate" = "unknown" ] || [ "$operstate" = "down" ]; then
        if [ -f "$iface_dir/carrier" ]; then
            carrier=""; read -r carrier < "$iface_dir/carrier" 2>/dev/null
            [ "$carrier" = "1" ] && operstate="up"
        fi
    fi
    # 计数器（rx tx rx_pkts tx_pkts）
    eval "_cnt=\${IFC_${_m}:-0 0 0 0}"
    set -- $_cnt
    rx_bytes=${1:-0}; tx_bytes=${2:-0}; rx_pkts=${3:-0}; tx_pkts=${4:-0}
    # 地址
    eval "ip4=\${ADR4_${_m}:-}"
    eval "ip6=\${ADR6_${_m}:-}"
    ip_addr="$ip4"
    [ -n "$ip6" ] && ip_addr="${ip4:+$ip4, }$ip6"
    # 接口类型
    iface_type="physical"
    case "$iface" in
        br-lan) iface_type="LAN" ;;
        pppoe-*|ppp-*) iface_type="WAN" ;;
        wan*|br-wan) iface_type="WAN" ;;
        wlan*|ra*) iface_type="WIFI" ;;
    esac
    # v4.13：PPPoE 用逻辑口自身计数器（IP payload，与运营商/协议分类口径一致）
    # UCI 识别：ethX 是某个非 PPPoE WAN 接口的底层设备时标记为 WAN（如 IPTV 专线 eth1=wan2）
    # 但排除 PPPoE 接口的底层物理口（如 eth0 是 pppoe-wan 的载体，流量已通过 pppoe-wan 体现，不重复计为 WAN）
    # v4.10：纯 shell 判断（旧实现每个 ethX 跑两次 uci show + grep 管道）
    if [ "$iface_type" = "physical" ]; then
        case "$iface" in
            lan*)
                _ad_lp=0
                for _pd in $_pppoe_base_devs; do [ "$_pd" = "$iface" ] && _ad_lp=1; done
                if [ "$_ad_lp" = "0" ]; then
                    case "$_uci_all" in
                        *"network.lan.device='$iface'"*) ;;
                        *"device='$iface'"*) iface_type="WAN" ;;
                    esac
                fi
                ;;
            eth*)
                _rest=${iface#eth}
                case "$_rest" in
                    ''|*[!0-9]*) ;;
                    *)
                        _is_pppoe_base=0
                        for _pd in $_pppoe_base_devs; do [ "$_pd" = "$iface" ] && _is_pppoe_base=1; done
                        if [ "$_is_pppoe_base" = "0" ]; then
                            # device 引用且非 lan 段（lan 段引用优先视为 LAN 底层口）
                            case "$_uci_all" in
                                *"network.lan.device='$iface'"*) ;;
                                *"device='$iface'"*) iface_type="WAN" ;;
                            esac
                        fi
                        ;;
                esac
                ;;
        esac
    fi
    # v4.6：速率计算移至前端，CGI 不再计算 rx_rate/tx_rate
    # v19：物理口链路协商速率/双工（端口卡数据源；无链路 sysfs 读 EINVAL → 留空落 0）
    link_speed=0; link_duplex=""
    case "$iface" in
        eth*|lan[0-9]*|wan*)
            _spd=""; read -r _spd < "$iface_dir/speed" 2>/dev/null
            case "$_spd" in
                ''|*[!0-9]*) ;;
                *) [ "$_spd" -gt 0 ] 2>/dev/null && { link_speed=$_spd; link_duplex=""; read -r link_duplex < "$iface_dir/duplex" 2>/dev/null; } ;;
            esac
            ;;
    esac
    case "$iface" in
        pppoe-*|ppp-*) _sm_pppoe_fold ;;
    esac
    net_lines="$net_lines{\"name\":\"$_ad_show\",\"type\":\"$iface_type\",\"state\":\"$operstate\",\"speed\":$link_speed,\"duplex\":\"$link_duplex\",\"rx\":$rx_bytes,\"tx\":$tx_bytes,\"rx_pkts\":$rx_pkts,\"tx_pkts\":$tx_pkts,\"ip\":\"$ip_addr\",\"ip4\":\"$ip4\",\"ip6\":\"$ip6\"},"
    net_state="${net_state}${iface}:rx=${rx_bytes},tx=${tx_bytes};"
done
[ -n "$PPPACC_NAMES" ] && _sm_pppoe_acct_save
[ -n "$net_lines" ] && net_lines=${net_lines%,} && net_ifs="[$net_lines]"

# ===== 客户端（DHCP 租约底册 + 邻居状态 + conntrack 流量，按设备合并）=====
# 口径与首页设备列表一致：以 /tmp/dhcp.leases 为设备清单底册（含主机名），
# 叠加邻居表状态：REACHABLE/DELAY/PROBE=活跃（近期有流量）、STALE=空闲（在线但静默）、
# 无邻居条目的租约设备=离线；FAILED/INCOMPLETE 仍排除。
# 同一设备（按 MAC）的 v4/v6 地址与 conntrack 流量合并为一行。
# v4.11：主查询每次请求都触发持久累计（前端 2s 轮询差分需要连续新鲜的累计值；
#        旧版 2s 节流与轮询同频导致 0/2x 速率跳变，故去掉节流，由 flock 串行化）
CLIENT_TOTALF="$PROTO_DIR/client-total-$(date +%F).txt"
client_accumulate
clients="[]"
client_lines=""
client_state=""

LSE=/tmp/dhcp.leases
[ -f "$LSE" ] || LSE=/dev/null

TMPL4=/tmp/.sm_neigh4.$$
TMPL6=/tmp/.sm_neigh6.$$
trap 'rm -f "$TMPL4" "$TMPL6"' EXIT
ip -4 neigh show 2>/dev/null > "$TMPL4"
ip -6 neigh show 2>/dev/null > "$TMPL6"

_ad_ct_agg_ensure
CTF=/tmp/adash-ct-agg
[ -f "$CTF" ] || CTF=/dev/null

# 一次 awk 扫描六个文件：租约(设备底册) -> conntrack(IP聚合) -> 当日持久累计 -> 速率缓存 -> v4/v6邻居
# v4.52：当日累计/速率查表并入同一 awk、主机名清洗内置，循环零 spawn——
#       原实现每客户端 11 次 grep/cut/sed 管道（25 客户端≈275 spawn，冷路径 -0.5s）
CLIENTS=$(awk -v CTF="$CTF" -v LSE="$LSE" -v TOTALF="$CLIENT_TOTALF" -v RATEF="$CLIENT_RATEF" '
function stripz(g){while(length(g)>1&&substr(g,1,1)=="0")g=substr(g,2);return g}
function canon(v,  p,h,t,hn,tn,i,g,out){
  v=tolower(v)
  if(v~/::/){
    split(v,p,"::");hn=0;tn=0
    if(p[1]!="")hn=split(p[1],h,":")
    if(p[2]!="")tn=split(p[2],t,":")
    for(i=1;i<=hn;i++)g[i]=h[i]
    for(i=1;i<=8-hn-tn;i++)g[hn+i]="0"
    for(i=1;i<=tn;i++)g[8-tn+i]=t[i]
  } else split(v,g,":")
  out=""
  for(i=1;i<=8;i++){if(i>1)out=out":";out=out stripz(g[i])}
  return out
}
# --- 文件1: DHCP 租约（dnsmasq 格式: 到期 MAC IP 主机名 clientid） ---
FILENAME==LSE{
  if($2!="" && index($2,":")>0){
    if($4!="" && $4!="*")host[$2]=$4
    lip[$2]=$3
    if(!($2 in seen)){seen[$2]=1;order[++k]=$2}
  }
  next
}
# --- 文件2: conntrack 聚合（客户端发起: 发送=orig_bytes, 接收=reply_bytes） ---
# 只统计请求方向（s1=发起方），不统计返回方向（s2=服务端），避免连接数翻倍
# 流量(up/dn)统计所有连接；连接数(cn)只统计活跃连接：
#   TCP=ESTABLISHED+OFFLOAD, UDP=ASSURED+OFFLOAD
FILENAME==CTF{
  # adash：读 30s 聚合缓存（ip|up|dn|cn），不再逐行解析 conntrack 全表
  split($0,_a,"|")
  if(_a[1]=="")next
  s1=_a[1]
  if(index(s1,":"))s1=canon(s1)
  up[s1]+=_a[2]+0;dn[s1]+=_a[3]+0
  cn[s1]+=_a[4]+0
  next
}
# --- 文件3: 当日持久累计（mac|rx|tx；v4.11 优先值，单调递增含离线设备） ---
FILENAME==TOTALF && TOTALF!="/dev/null"{
  split($0,_t,"|")
  if(_t[1]!="" && index(_t[1],":")>0){trxf[_t[1]]+=_t[2]+0; ttxf[_t[1]]+=_t[3]+0}
  next
}
# --- 文件4: 速率缓存（mac|ts|rx|tx|rx_rate|tx_rate；CGI 端 6s 滑动窗口） ---
FILENAME==RATEF && RATEF!="/dev/null"{
  split($0,_r,"|")
  if(_r[1]!=""){rrxf[_r[1]]=_r[5]+0; rtxf[_r[1]]=_r[6]+0}
  next
}
# --- 文件5/6: 邻居表（含 STALE=空闲） ---
{
  ip=$1;mac="";dev=""
  for(i=2;i<NF;i++){
    if($i=="dev"&&dev=="")dev=$(i+1)
    else if($i=="lladdr"&&mac=="")mac=$(i+1)
  }
  st=$NF
  if(ip=="")next
  if(st!="REACHABLE"&&st!="DELAY"&&st!="PROBE"&&st!="STALE")next
  if(mac==""||mac=="00:00:00:00:00:00")next
  ver=4
  if(index(ip,":")){
    if(substr(ip,1,5)=="fe80:")next
    # v4.17：IPv6 只认近期可达，丢掉 STALE 残留（关 IPv6 / 前缀轮换后旧 SLAAC 会挂很久）
    if(st=="STALE")next
    ver=6
  }
  if(dev!="br-lan"&&dev!~/^(br-|wlan|ra|ath|apcli)/)next
  if(!(mac in seen)){seen[mac]=1;order[++k]=mac}
  if(st!="STALE")act[mac]=1
  if(ver==4){
    if(st!="STALE"){m4live[mac]=ip; m4[mac]=ip}
    else if(!(mac in m4))m4[mac]=ip
  } else {
    if(m6[mac]=="")m6[mac]=ip;else m6[mac]=m6[mac] "," ip
  }
  key=ip
  if(ver==6)key=canon(ip)
  if(key in cn)totconn[mac]+=cn[key]
  if(key in dn)totrx[mac]+=dn[key]
  if(key in up)tottx[mac]+=up[key]
}
END{
  for(i=1;i<=k;i++){
    m=order[i]
    st="offline"
    if(m in act)st="active"
    else if((m in m4)||(m in m6))st="idle"
    nm=(m in host)?host[m]:""
    v4=""
    if(m in m4live)v4=m4live[m]
    else if(m in lip)v4=lip[m]
    else if(m in m4)v4=m4[m]
    v6=(m in m6)?m6[m]:""
    ip=v4
    if(ip==""){if(v6!=""){split(v6,t6,",");ip=t6[1]}}
    ver=(v4!="")?((v6!="")?"46":"4"):"6"
    # 离线设备（无邻居条目）也查一次租约 IP 的 conntrack 残留计数
    if(!(m in m4)&&v4!=""){
      if(v4 in cn)totconn[m]+=cn[v4]
      if(v4 in dn)totrx[m]+=dn[v4]
      if(v4 in up)tottx[m]+=up[v4]
    }
    # v4.11 口径 + v4.52 查表合并：当日持久累计优先，回退 conntrack 即时值
    if(m in trxf){rx=trxf[m]+0;tx=ttxf[m]+0}else{rx=totrx[m]+0;tx=tottx[m]+0}
    rr=(m in rrxf)?rrxf[m]+0:0
    rt=(m in rtxf)?rtxf[m]+0:0
    gsub(/["\\<>]/,"",nm)
    printf "%s|%s|%s|%s|%s|%s|%d|%d|%d|%d|%d\n",nm,ip,m,st,ver,v6,totconn[m]+0,rx,tx,rr,rt
  }
}' "$LSE" "$CTF" "$CLIENT_TOTALF" "$CLIENT_RATEF" "$TMPL4" "$TMPL6" 2>/dev/null)

# v4.52：awk 已合并累计/速率查表与主机名清洗，循环只做字符串拼接（零 spawn）
while IFS='|' read -r cname cip cmac cst cver cv6 cconn crx ctx crxr ctxr; do
    [ -z "$cmac" ] && continue
    client_lines="$client_lines{\"name\":\"$cname\",\"ip\":\"$cip\",\"ip6\":\"$cv6\",\"mac\":\"$cmac\",\"state\":\"$cst\",\"version\":\"$cver\",\"connections\":$cconn,\"rx\":$crx,\"tx\":$ctx,\"rx_rate\":$crxr,\"tx_rate\":$ctxr},"
    client_state="${client_state}${cmac}:rx=${crx},tx=${ctx};"
done <<CLIENTS_EOF
$CLIENTS
CLIENTS_EOF

if [ -n "$client_lines" ]; then client_lines=${client_lines%,}; clients="[$client_lines]"; fi


# ===== 磁盘 =====
# v4.52：df 单次 awk 直接产出 JSON（原逐行 6×echo/awk/tr 管道，~40 spawn）
disk="[]"
disk_lines=$(df 2>/dev/null | awk '
    NR>1 && $1!~/^(tmpfs|devtmpfs|overlay)/ {
        if($6=="")next
        u=$5; gsub(/%/,"",u)
        printf "{\"mount\":\"%s\",\"fs\":\"%s\",\"total\":%s,\"used\":%s,\"free\":%s,\"usepct\":%s},", $6,$1,$2,$3,$4,u+0
    }')
if [ -n "$disk_lines" ]; then disk="[$(printf '%s' "$disk_lines" | sed 's/,$//')]"; fi

# ===== 服务状态 =====
# firewall 用 nft 规则检测（fw4 非常驻进程，pidof 永远查不到）
# v4.52：pidof 多 PID 用纯 shell 截断（原每服务 echo|awk 管道）
services="[]"
svc_lines=""
for svc in uhttpd dnsmasq iptv-auth rtp2httpd cron firewall; do
    pid=""
    _pids=$(pidof "$svc" 2>/dev/null)
    if [ -n "$_pids" ]; then
        pid=${_pids%% *}
        status="running"
    elif pgrep -f "$svc" >/dev/null 2>&1; then
        pid=$(pgrep -f "$svc" | head -1)
        status="running"
    elif [ "$svc" = "firewall" ] && nft list chain inet fw4 input >/dev/null 2>&1; then
        status="running"
    else
        status="stopped"
    fi
    svc_lines="$svc_lines{\"name\":\"$svc\",\"status\":\"$status\",\"pid\":${pid:-0}},"
done
if [ -n "$svc_lines" ]; then svc_lines=${svc_lines%,}; services="[$svc_lines]"; fi

# ===== 快捷入口：仅返回已开启/在跑的用户服务（文件管理由前端固定显示）=====
lan_ip=$(uci -q get network.lan.ipaddr)
lan_ip=${lan_ip%%/*}
[ -z "$lan_ip" ] && lan_ip="192.168.10.1"
live_port=$(uci -q get iptv-auth.main.live_port)
live_port=${live_port:-23234}
_sc_host=$HTTP_HOST
case "$_sc_host" in
    *:*)
        _sc_port=${_sc_host##*:}
        case "$_sc_port" in
            *[!0-9]*) ;;
            *) _sc_host=${_sc_host%:*} ;;
        esac
        ;;
esac
[ -z "$_sc_host" ] && _sc_host=$lan_ip
_sc_alive() {
    local p pat
    for p in "$@"; do
        case "$p" in
            *.py|*/*)
                pat="[${p%${p#?}}]${p#?}"
                pgrep -f "$pat" >/dev/null 2>&1 && return 0
                ;;
            *)
                pidof "$p" >/dev/null 2>&1 && return 0
                pgrep -x "$p" >/dev/null 2>&1 && return 0
                ;;
        esac
    done
    return 1
}
_sc_on() {
    [ "$1" = "1" ] && return 0
    shift
    _sc_alive "$@"
}
sc_add() {
    if [ -n "${4:-}" ]; then
        sc_lines="${sc_lines}{\"id\":\"$1\",\"label\":\"$2\",\"href\":\"$3\",\"target\":\"$4\"},"
    else
        sc_lines="${sc_lines}{\"id\":\"$1\",\"label\":\"$2\",\"href\":\"$3\"},"
    fi
}
sc_lines=""
if _sc_on "$(uci -q get iptv-auth.main.enabled)" iptv-auth.py rtp2httpd; then
    sc_add iptv "IPTV 代理" "/cgi-bin/luci/admin/services/iptv_auth/status"
    sc_add rtp2httpd "rtp2httpd" "http://${_sc_host}:${live_port}/status" "_blank"
fi
if _sc_on "" mediahub-cms.py alist; then
    sc_add mediahub "影视中心" "/cgi-bin/luci/admin/services/mediahub"
elif [ -x /etc/init.d/mediahub-cms ] && /etc/init.d/mediahub-cms enabled 2>/dev/null; then
    sc_add mediahub "影视中心" "/cgi-bin/luci/admin/services/mediahub"
fi
_sc_on "$(uci -q get lucky.@lucky[0].enabled)" lucky && sc_add lucky "Lucky" "/cgi-bin/luci/admin/services/lucky"
_sc_on "$(uci -q get daed.config.enabled)" daed dae && sc_add daed "Daed" "/cgi-bin/luci/admin/services/daede/config"
_sc_on "$(uci -q get natfrp.main.enabled)" natfrp-service && sc_add natfrp "Sakura Frp" "/cgi-bin/luci/admin/services/natfrp"
if _sc_on "" dockerd || { [ -x /etc/init.d/dockerd ] && /etc/init.d/dockerd enabled 2>/dev/null; }; then
    sc_add docker "Docker" "/cgi-bin/luci/admin/services/dockerman/overview"
fi
_sc_on "" ttyd && sc_add ttyd "终端" "/cgi-bin/luci/admin/system/ttyd/ttyd"
_sc_on "$(uci -q get upnpd.config.enabled)" miniupnpd && sc_add upnp "UPnP" "/cgi-bin/luci/admin/services/upnp"
[ -n "$sc_lines" ] && sc_lines=$(echo "$sc_lines" | sed 's/,$//')
shortcuts="[$sc_lines]"

# ===== 保存状态（v4.12：wan 字段随按天统计退役移除，net/clients 保留供其他用途）=====
printf '{"ts":%d,"net":"%s","clients":"%s"}\n' \
    "$NOW" "$net_state" "$client_state" > "$STATE" 2>/dev/null



# ===== 复用概览页数据源（ubus system info/board + getTempInfo + worker CPU，v4.49）=====
if command -v ubus >/dev/null 2>&1; then
    _ub_info=$(ubus call system info 2>/dev/null)
    if [ -n "$_ub_info" ]; then
        _ub_up=$(printf '%s' "$_ub_info" | jsonfilter -e '@.uptime' 2>/dev/null)
        _ub_l1=$(printf '%s' "$_ub_info" | jsonfilter -e '@.load[0]' 2>/dev/null)
        _ub_l5=$(printf '%s' "$_ub_info" | jsonfilter -e '@.load[1]' 2>/dev/null)
        _ub_l15=$(printf '%s' "$_ub_info" | jsonfilter -e '@.load[2]' 2>/dev/null)
        _ub_mt=$(printf '%s' "$_ub_info" | jsonfilter -e '@.memory.total' 2>/dev/null)
        _ub_mf=$(printf '%s' "$_ub_info" | jsonfilter -e '@.memory.free' 2>/dev/null)
        _ub_ma=$(printf '%s' "$_ub_info" | jsonfilter -e '@.memory.available' 2>/dev/null)
        _ub_mc=$(printf '%s' "$_ub_info" | jsonfilter -e '@.memory.cached' 2>/dev/null)
        _ub_mb=$(printf '%s' "$_ub_info" | jsonfilter -e '@.memory.buffered' 2>/dev/null)
        case "$_ub_up" in ''|*[!0-9]*) ;; *) uptime_s=$_ub_up ;; esac
        case "$_ub_l1" in ''|*[!0-9]*) ;; *) load1=$(awk -v v="$_ub_l1" 'BEGIN{printf "%.2f", v/65536}') ;; esac
        case "$_ub_l5" in ''|*[!0-9]*) ;; *) load5=$(awk -v v="$_ub_l5" 'BEGIN{printf "%.2f", v/65536}') ;; esac
        case "$_ub_l15" in ''|*[!0-9]*) ;; *) load15=$(awk -v v="$_ub_l15" 'BEGIN{printf "%.2f", v/65536}') ;; esac
        if [ -n "$_ub_mt" ] && [ "$_ub_mt" -gt 0 ] 2>/dev/null; then
            mem_total=$((_ub_mt / 1024)); mem_free=$((_ub_mf / 1024))
            mem_avail=$((_ub_ma / 1024)); mem_cached=$((_ub_mc / 1024)); mem_buf=$((_ub_mb / 1024))
            mem_used=$((mem_total - mem_free - mem_cached - mem_buf))
        fi
    fi
    _ub_board=$(ubus call system board 2>/dev/null)
    if [ -n "$_ub_board" ]; then
        _ub_hn=$(printf '%s' "$_ub_board" | jsonfilter -e '@.hostname' 2>/dev/null)
        _ub_kr=$(printf '%s' "$_ub_board" | jsonfilter -e '@.kernel' 2>/dev/null)
        _ub_bn=$(printf '%s' "$_ub_board" | jsonfilter -e '@.board_name' 2>/dev/null)
        [ -n "$_ub_hn" ] && hostname=$_ub_hn
        [ -n "$_ub_kr" ] && kernel=$_ub_kr
        [ -n "$_ub_bn" ] && board=$_ub_bn
    fi
    # adash：CPU 视图请求间差分（/proc/stat；无人查看零成本）
    _ad_v=$(_ad_cpu_view)
    [ "$_ad_v" -ge 0 ] 2>/dev/null && cpu_usage=$_ad_v
    _ub_t=$(ubus call luci getTempInfo 2>/dev/null | sed -n 's/.*CPU:[ ]*\([0-9.]*\).*/\1/p')
    case "$_ub_t" in ''|*[!0-9.]*) ;; *) temp_c=$_ub_t ;; esac
fi

# ===== adash: WAN 公网 IP + DNS（网络路径模块数据源）=====
_ad_wan_pub=""; _ad_wan_dns=""
_ub_net=$(ubus call network.interface dump 2>/dev/null)
if [ -n "$_ub_net" ]; then
    # 全接口 IPv4 中挑全局地址（非 RFC1918/CGNAT/链路本地/环回），覆盖 pppoe 公网
    _ad_wan_pub=$(printf '%s' "$_ub_net" | jsonfilter -e '@.interface[*].ipv4-address[*].address' 2>/dev/null | awk -F. '{
        a=$1+0;b=$2+0
        if(a==10||a==127||(a==172&&b>=16&&b<=31)||(a==192&&b==168)||(a==169&&b==254)||(a==100&&b>=64&&b<=127))next
        print;exit
    }')
    # 纯 CGNAT/内网环境回退：wan 口自身地址
    if [ -z "$_ad_wan_pub" ]; then
        _ad_wan_pub=$(printf '%s' "$_ub_net" | jsonfilter -e '@.interface[@.up=true].ipv4-address[0].address' 2>/dev/null | head -1)
    fi
fi
for _f in /tmp/resolv.conf.d/resolv.conf.auto /tmp/resolv.conf.auto; do
    [ -r "$_f" ] && { _ad_wan_dns=$(awk '/^nameserver/&&$2!="127.0.0.1"{print $2;exit}' "$_f" 2>/dev/null); [ -n "$_ad_wan_dns" ] && break; }
done
_ad_wan_pub=${_ad_wan_pub:-"--"}
_ad_wan_dns=${_ad_wan_dns:-127.0.0.1}

# ===== 输出 JSON =====
_ad_ppe=$(_ad_ppe_json)
cat <<JSONEOF
{
  "ppe": $_ad_ppe,
  "wan": {"pub": "$_ad_wan_pub", "dns": "$_ad_wan_dns"},
  "system": {
    "hostname": "$hostname",
    "kernel": "$kernel",
    "firmware": "$firmware",
    "uptime": $uptime_s,
    "load": [$load1, $load5, $load15],
    "board": "$board",
    "cpu_model": "$cpu_model",
    "cpu_cores": $cpu_cores,
    "cpu_usage": $cpu_usage,
    "cpu_freq": $cpu_freq,
    "cpu_freq_min": $cpu_freq_min,
    "cpu_freq_max": $cpu_freq_max,
    "temperature": $temp_c,
    "disk_temp": $disk_c,
    "fan_rpm": $fan_rpm
  },
  "memory": {
    "total": $mem_total,
    "used": $mem_used,
    "free": $mem_free,
    "available": $mem_avail,
    "cached": $mem_cached,
    "buffers": $mem_buf
  },
  "protocols": {
    "tcp_current": $proto_tcp_curr,
    "tcp_total": $proto_tcp_total,
    "tcp_retrans": $proto_tcp_ret,
    "udp_total": $proto_udp,
    "udp_inerrors": $proto_udp_ret,
    "icmp_total": $proto_icmp,
    "ip_total": $proto_ip_total,
    "conntrack_current": $ct_total,
    "conntrack_max": $ct_max,
    "ct_tcp_estab": $ct_tcp_estab,
    "ct_tcp_total": $ct_tcp_total,
    "ct_udp": $ct_udp,
    "ct_udp_total": $ct_udp_total,
    "ct_icmp": $ct_icmp,
    "ct_external": $ct_external,
    "ct_tcp_act": ${ct_tcp_act:-0},
    "ct_tcp_idle": ${ct_tcp_idle:-0}
  },
  "network": $net_ifs,
  "clients": $clients,
  "disk": $disk,
  "services": $services,
  "shortcuts": $shortcuts,
  "timestamp": $NOW
}
JSONEOF
exec 1>&7 7>&-
[ -s "$_sm_cache.tmp.$$" ] && mv -f "$_sm_cache.tmp.$$" "$_sm_cache"
cat "$_sm_cache"
