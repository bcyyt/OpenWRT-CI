#!/bin/sh /etc/rc.common
# zte-wifi — 中兴 mesh 无线客户端采集守护（输出 /tmp/zte-wifi.json）

START=99
USE_PROCD=1

start_service() {
        # 未配置（无 /etc/zte-wifi.conf）时不启动，避免空转
        [ -s /etc/zte-wifi.conf ] || { echo "zte-wifi: /etc/zte-wifi.conf 不存在，跳过启动"; return 0; }
        procd_open_instance
        procd_set_param command /usr/bin/python3 /usr/lib/zte-wifi.py
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
}
