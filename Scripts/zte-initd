#!/bin/sh /etc/rc.common
# zte-wifi — 中兴 mesh 无线客户端采集守护（输出 /tmp/zte-wifi.json）
START=99
USE_PROCD=1

start_service() {
	# UCI 配置（/etc/config/zte-wifi，LuCI 页面维护）或旧 JSON（/etc/zte-wifi.conf）任一存在即启动
	if [ -s /etc/config/zte-wifi ] || [ -s /etc/zte-wifi.conf ]; then
		:
	else
		echo "zte-wifi: 无配置（/etc/config/zte-wifi 与 /etc/zte-wifi.conf 均不存在），跳过启动"
		return 0
	fi
	procd_open_instance
	procd_set_param command /usr/bin/python3 /usr/lib/zte-wifi.py
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
