#!/bin/sh
# 首启注册 24h 曲线每分钟累计 cron（幂等：标记存在即跳过）
# adash 低 CPU 设计：cron 只做 nft 计数累计 + sys_hist 采样（约几十 ms/分钟），
# PPE/conntrack/CPU 均为视图驱动，无人查看零成本
grep -q 'adash-acct-accumulate' /etc/crontabs/root 2>/dev/null || \
        echo '* * * * * QUERY_STRING=accumulate=1 /www/cgi-bin/adash >/dev/null 2>&1 # adash-acct-accumulate' >> /etc/crontabs/root
exit 0
