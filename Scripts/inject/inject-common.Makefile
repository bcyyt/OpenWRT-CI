# SPDX-License-Identifier: MIT
# prebuilt ipk inject - static skeleton; per-package values in inject.inc
# generated by Scripts/Packages.sh BCYYT_INJECT (printf line-by-line)

include $(TOPDIR)/rules.mk

include inject.inc

include $(INCLUDE_DIR)/package.mk

define Build/Prepare
	rm -rf $(PKG_BUILD_DIR)
	mkdir -p $(PKG_BUILD_DIR)/ipk $(PKG_BUILD_DIR)/root
	tar -C $(PKG_BUILD_DIR)/ipk -xzf $(DL_DIR)/$(PKG_SOURCE)
	tar -C $(PKG_BUILD_DIR)/root -xzf $(PKG_BUILD_DIR)/ipk/data.tar.gz
endef

define Build/Compile
endef

define Package/$(PKG_NAME)/install
	$(CP) $(PKG_BUILD_DIR)/root/. $(1)/
endef

$(eval $(call BuildPackage,$(PKG_NAME)))
