#!/bin/sh
# IPv6 over PPPoE 稳定性修复 (2026-11-26)：wan_6 崩溃循环 + wan6 无地址
# 坑A: network.wan.ipv6='1' 使 netifd 动态生成 wan_6，其 handler 在部分源码上无限
#      崩溃(ubus Invalid argument)，并以重复 DHCPv6 会话拖慢前缀获取(实测 2~16 分钟)；
#      删除后 pppd 照常协商 IPv6CP，静态 wan6 独占 DHCPv6，实测拨号后 6 秒拿前缀。
# 坑B: wan6(dhcpv6) 缺 reqaddress → odhcp6c 不带 -Ntry；国内 BRAS 只发 IA_PD 不发
#      IA_NA，地址靠 SLAAC，缺参数则 odhcp6c 不上报地址(wan6 拿到前缀却无地址)。
# 守卫: 无 IPv6 内核支持或 wan6 非 dhcpv6 的板卡静默跳过，全线(MTK/AIROHA/lede)安全。
[ -e /proc/sys/net/ipv6 ] || exit 0
uci -q delete network.wan.ipv6
[ "$(uci -q get network.wan6.proto)" = "dhcpv6" ] && {
        uci -q set network.wan6.reqaddress='try'
        uci -q commit network
}
exit 0
